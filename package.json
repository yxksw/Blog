{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/ensure-sitemap-xml.mjs",
    "push": "astro build && node scripts/ensure-sitemap-xml.mjs && npx wrangler pages deploy dist --project-name=blog",
    "deploy": "cd Blogs_worker && wrangler deploy --config wrangler.toml",
    "postbuild": "node scripts/postbuild-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.1",
    "marked": "^17.0.4",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19"
  }
}
