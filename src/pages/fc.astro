---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';

const title = `友链朋友圈 | ${SITE_TITLE}`;
const description = '追踪友链博客的最新动态，发现更多精彩内容';
---

<MainLayout title={title} description={description}>
    <!-- Friend Circle Lite Styles -->
    <link rel="stylesheet" href="https://fastly.jsdelivr.net/gh/willow-god/Friend-Circle-Lite@main/main/fclite.min.css">

    <!-- Custom Styles for Integration -->
    <style>
        /* 适配暗色模式 */
        html.dark #friend-circle-lite-root {
            --text-color: #F7F7FA;
            --background-color: #181818;
            --container-bg-color: #1D1E22;
            --author-color: #b3b3b3;
            --shadow-color: rgba(255, 255, 255, 0.1);
            --border-color: #42444a;
            --modal-bg-color: rgba(0, 0, 0, 0.3);
            --modal-content-bg-color: rgba(20, 20, 20, 0.5);
        }

        html:not(.dark) #friend-circle-lite-root {
            --text-color: #000000;
            --background-color: #f4f4f9;
            --container-bg-color: white;
            --author-color: gray;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --border-color: #e3e8f7;
            --modal-bg-color: rgba(255, 255, 255, 0.5);
            --modal-content-bg-color: rgba(239, 250, 255, 0.5);
        }

        /* 调整容器样式 */
        #friend-circle-lite-root {
            width: 100%;
        }

        /* 随机文章卡片样式优化 */
        #random-article {
            background-color: var(--container-bg-color);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            margin: 16px 0;
        }

        /* 文章卡片样式优化 */
        .card {
            background-color: var(--container-bg-color);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px var(--shadow-color);
        }

        .card-title {
            color: var(--text-color);
        }

        .card-author {
            color: var(--author-color);
        }

        /* 加载更多按钮样式 */
        #load-more-btn {
            background-color: var(--container-bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            border-radius: 8px;
            padding: 12px 24px;
            margin: 20px auto;
            display: block;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        #load-more-btn:hover {
            background-color: var(--hover-color, #3498db);
            color: white;
            border-color: var(--hover-color, #3498db);
        }

        /* 统计信息样式 */
        #stats-container {
            text-align: center;
            color: var(--author-color);
            font-size: 14px;
            margin-top: 20px;
            padding: 16px;
            background-color: var(--container-bg-color);
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }

        #stats-container a {
            color: var(--hover-color, #3498db);
            text-decoration: none;
        }

        #stats-container a:hover {
            text-decoration: underline;
        }

        /* 弹窗样式优化 */
        .modal-content {
            background-color: var(--modal-content-bg-color);
            border: 1px solid var(--border-color);
            border-radius: 16px;
        }

        /* 响应式调整 */
        @media (max-width: 640px) {
            .articles-container {
                grid-template-columns: 1fr !important;
            }
        }
    </style>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mb-4">友链朋友圈</h1>
            <p class="text-lg text-zinc-600 dark:text-zinc-400">
                追踪友链博客的最新动态，发现更多精彩内容
            </p>
        </div>

        <!-- Friend Circle Lite Container -->
        <div id="friend-circle-lite-root"></div>

        <!-- Back to Links -->
        <div class="mt-12 text-center">
            <a
                href="/links/"
                class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-6 py-3 text-base font-medium text-zinc-900 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
                返回友链页面
            </a>
        </div>
    </div>

    <!-- Friend Circle Lite Script with View Transitions support -->
    <script is:inline>
        (function() {
            // 配置
            window.UserConfig = {
                private_api_url: 'https://fc.050815.xyz/',
                page_turning_number: 20,
                error_img: 'https://api.dicebear.com/7.x/initials/svg?seed=FC'
            };

            // 标记是否已加载脚本
            window._fcliteScriptLoaded = window._fcliteScriptLoaded || false;

            // 加载外部脚本
            function loadScript() {
                return new Promise(function(resolve, reject) {
                    // 如果脚本已经加载过，直接返回
                    if (window._fcliteScriptLoaded) {
                        resolve();
                        return;
                    }

                    // 检查是否已存在脚本标签
                    var existingScript = document.querySelector('script[data-fclite]');
                    if (existingScript) {
                        window._fcliteScriptLoaded = true;
                        resolve();
                        return;
                    }

                    var script = document.createElement('script');
                    script.src = 'https://fastly.jsdelivr.net/gh/willow-god/Friend-Circle-Lite@main/main/fclite.min.js';
                    script.setAttribute('data-fclite', 'true');
                    script.onload = function() {
                        window._fcliteScriptLoaded = true;
                        resolve();
                    };
                    script.onerror = function() {
                        reject(new Error('Failed to load fclite script'));
                    };
                    document.body.appendChild(script);
                });
            }

            // 初始化函数
            function initFriendCircle() {
                // 检查当前页面是否有 friend-circle-lite-root 容器
                var root = document.getElementById('friend-circle-lite-root');
                if (!root) {
                    return; // 不在当前页面，不初始化
                }

                // 清空容器（防止重复渲染）
                root.innerHTML = '';

                loadScript().then(function() {
                    if (typeof initialize_fc_lite === 'function') {
                        initialize_fc_lite();
                    }
                }).catch(function() {
                    if (root) {
                        root.innerHTML = '<div style="text-align:center;padding:40px;color:#999;">加载失败，请刷新页面重试</div>';
                    }
                });
            }

            // 立即执行（首次加载）
            initFriendCircle();

            // 监听 Astro View Transitions 事件
            document.addEventListener('astro:page-load', initFriendCircle);
            document.addEventListener('astro:after-swap', initFriendCircle);
        })();
    </script>
</MainLayout>
