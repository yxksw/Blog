---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import { SITE_TITLE } from '../consts';

// Friend-Circle-Lite 数据接口
interface Article {
    title: string;
    created: string;
    link: string;
    author: string;
    avatar: string;
}

interface StatisticalData {
    friends_num: number;
    active_num: number;
    error_num: number;
    article_num: number;
    last_updated_time: string;
}

interface FriendCircleData {
    statistical_data: StatisticalData;
    article_data: Article[];
}

// 从 Friend-Circle-Lite 加载数据
async function loadFriendCircleData(): Promise<FriendCircleData | null> {
    try {
        const response = await fetch('https://fc.050815.xyz/all.json');
        if (!response.ok) {
            throw new Error('Failed to load friend circle data');
        }
        return await response.json();
    } catch (error) {
        console.error('Failed to load friend circle data:', error);
        return null;
    }
}

// 格式化日期
function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    const now = new Date();
    const diffTime = now.getTime() - date.getTime();
    const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
    
    if (diffDays === 0) {
        const diffHours = Math.floor(diffTime / (1000 * 60 * 60));
        if (diffHours === 0) {
            const diffMinutes = Math.floor(diffTime / (1000 * 60));
            return diffMinutes === 0 ? '刚刚' : `${diffMinutes}分钟前`;
        }
        return `${diffHours}小时前`;
    } else if (diffDays === 1) {
        return '昨天';
    } else if (diffDays < 7) {
        return `${diffDays}天前`;
    } else if (diffDays < 30) {
        return `${Math.floor(diffDays / 7)}周前`;
    } else {
        return date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
    }
}

const data = await loadFriendCircleData();
const stats = data?.statistical_data;
const articles = data?.article_data || [];

const title = `友链朋友圈 | ${SITE_TITLE}`;
const description = '追踪友链博客的最新动态，发现更多精彩内容';
---

<!doctype html>
<html lang="zh-CN">
<head>
    <BaseHead title={title} description={description} />
</head>
<body class="bg-zinc-50 dark:bg-zinc-900">
    <Header />
    <MobileDrawer />
    
    <main class="min-h-screen py-10">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="text-center mb-12">
                <h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mb-4">友链朋友圈</h1>
                <p class="text-lg text-zinc-600 dark:text-zinc-400">
                    追踪友链博客的最新动态，发现更多精彩内容
                </p>
            </div>

            <!-- Stats Cards -->
            {stats && (
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
                    <div class="bg-white dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700 p-4 text-center">
                        <div class="text-2xl font-bold text-zinc-900 dark:text-white mb-1">{stats.friends_num}</div>
                        <div class="text-sm text-zinc-500 dark:text-zinc-400">友链总数</div>
                    </div>
                    <div class="bg-white dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700 p-4 text-center">
                        <div class="text-2xl font-bold text-green-600 dark:text-green-400 mb-1">{stats.active_num}</div>
                        <div class="text-sm text-zinc-500 dark:text-zinc-400">活跃站点</div>
                    </div>
                    <div class="bg-white dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700 p-4 text-center">
                        <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-1">{stats.article_num}</div>
                        <div class="text-sm text-zinc-500 dark:text-zinc-400">文章总数</div>
                    </div>
                    <div class="bg-white dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700 p-4 text-center">
                        <div class="text-2xl font-bold text-orange-600 dark:text-orange-400 mb-1">{stats.error_num}</div>
                        <div class="text-sm text-zinc-500 dark:text-zinc-400">异常站点</div>
                    </div>
                </div>
            )}

            <!-- Random Fishing -->
            {articles.length > 0 && (
                <div class="mb-10" id="random-fishing" data-articles={JSON.stringify(articles)}>
                    <div class="bg-white dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700 p-6">
                        <div class="flex items-center gap-2 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500">
                                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                                <path d="M8.5 8.5v.01"/>
                                <path d="M16 15.5v.01"/>
                                <path d="M12 12v.01"/>
                                <path d="M11 17v.01"/>
                                <path d="M7 14v.01"/>
                            </svg>
                            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">随机钓鱼</h2>
                        </div>
                        <div id="fishing-content" class="mb-4">
                            <a id="fishing-link" href="#" target="_blank" rel="noopener noreferrer" class="block group">
                                <h3 id="fishing-title" class="text-xl font-semibold text-zinc-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                                    点击刷新按钮开始钓鱼...
                                </h3>
                                <p id="fishing-author" class="text-sm text-zinc-500 dark:text-zinc-400">
                                    作者：-
                                </p>
                            </a>
                        </div>
                        <div class="flex items-center justify-end gap-3">
                            <button 
                                id="refresh-fishing" 
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700/50 transition-colors text-sm"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                                    <path d="M21 3v5h-5"/>
                                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                                    <path d="M8 16H3v5"/>
                                </svg>
                                刷新
                            </button>
                            <a 
                                id="visit-fishing" 
                                href="#" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition-colors text-sm font-medium"
                            >
                                过去转转
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14"/>
                                    <path d="m12 5 7 7-7 7"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            )}

            <!-- Last Updated -->
            {stats?.last_updated_time && (
                <div class="flex items-center justify-center gap-2 text-sm text-zinc-500 dark:text-zinc-400 mb-8">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>最后更新：{stats.last_updated_time}</span>
                    <a 
                        href="https://github.com/willow-god/Friend-Circle-Lite" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="ml-2 text-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                    >
                        Powered by FCL
                    </a>
                </div>
            )}

            <div class="mt-12 text-center">
                <a
                    href="/links/"
                    class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-6 py-3 text-base font-medium text-zinc-900 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                    返回友链页面
                </a>
            </div>

            <!-- Articles List -->
            <div class="space-y-4">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500">
                            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
                            <path d="M18 14h-8"/>
                            <path d="M15 18h-5"/>
                            <path d="M10 6h8v4h-8V6Z"/>
                        </svg>
                        最新文章
                    </h2>
                    <span class="text-sm text-zinc-500 dark:text-zinc-400">
                        共 {articles.length} 篇
                    </span>
                </div>

                {articles.length === 0 ? (
                    <div class="text-center py-16 bg-white dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-zinc-300 dark:text-zinc-600 mb-4">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" x2="12" y1="8" y2="12"/>
                            <line x1="12" x2="12.01" y1="16" y2="16"/>
                        </svg>
                        <p class="text-zinc-500 dark:text-zinc-400">暂无文章数据</p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 gap-4">
                        {articles.map((article) => (
                            <a
                                href={article.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group flex items-start gap-4 p-4 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/50 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md transition-all duration-300"
                            >
                                {/* Avatar */}
                                <div class="flex-shrink-0">
                                    <img
                                        src={article.avatar}
                                        alt={article.author}
                                        class="w-12 h-12 rounded-full object-cover border-2 border-zinc-100 dark:border-zinc-700 group-hover:border-blue-200 dark:group-hover:border-blue-800 transition-colors"
                                        loading="lazy"
                                        onerror="this.src='https://api.dicebear.com/7.x/initials/svg?seed=' + encodeURIComponent(this.alt)"
                                    />
                                </div>

                                {/* Content */}
                                <div class="flex-grow min-w-0">
                                    <h3 class="font-semibold text-zinc-900 dark:text-white mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
                                        {article.title}
                                    </h3>
                                    <div class="flex items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
                                        <span class="flex items-center gap-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                            {article.author}
                                        </span>
                                        <span class="text-zinc-300 dark:text-zinc-600">·</span>
                                        <span class="flex items-center gap-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                                                <line x1="16" x2="16" y1="2" y2="6"/>
                                                <line x1="8" x2="8" y1="2" y2="6"/>
                                                <line x1="3" x2="21" y1="10" y2="10"/>
                                            </svg>
                                            {formatDate(article.created)}
                                        </span>
                                    </div>
                                </div>

                                {/* Arrow */}
                                <div class="flex-shrink-0 self-center opacity-0 group-hover:opacity-100 transition-opacity">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 group-hover:text-blue-500 transition-colors">
                                        <path d="M5 12h14"/>
                                        <path d="m12 5 7 7-7 7"/>
                                    </svg>
                                </div>
                            </a>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </main>

    <Footer />

    <script is:inline>
        (function() {
            const fishingContainer = document.getElementById('random-fishing');
            if (!fishingContainer) return;

            const articlesData = fishingContainer.dataset.articles;
            if (!articlesData) return;

            let articles = [];
            try {
                articles = JSON.parse(articlesData);
            } catch (e) {
                console.error('Failed to parse articles:', e);
                return;
            }

            const fishingTitle = document.getElementById('fishing-title');
            const fishingAuthor = document.getElementById('fishing-author');
            const fishingLink = document.getElementById('fishing-link');
            const visitFishing = document.getElementById('visit-fishing');
            const refreshBtn = document.getElementById('refresh-fishing');

            function getRandomArticle() {
                if (articles.length === 0) return null;
                const randomIndex = Math.floor(Math.random() * articles.length);
                return articles[randomIndex];
            }

            function updateFishingCard() {
                const article = getRandomArticle();
                if (!article) return;

                fishingTitle.textContent = article.title;
                fishingAuthor.textContent = '作者：' + article.author;
                fishingLink.href = article.link;
                visitFishing.href = article.link;
            }

            // Initialize with a random article
            updateFishingCard();

            // Refresh button click handler
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function() {
                    // Add spin animation to refresh icon
                    const icon = refreshBtn.querySelector('svg');
                    if (icon) {
                        icon.style.transition = 'transform 0.3s ease';
                        icon.style.transform = 'rotate(360deg)';
                        setTimeout(() => {
                            icon.style.transform = 'rotate(0deg)';
                        }, 300);
                    }
                    updateFishingCard();
                });
            }
        })();
    </script>
</body>
</html>
