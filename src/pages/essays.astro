---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

// 配置 marked 选项
marked.setOptions({
    gfm: true,
    breaks: true
});

const title = `碎碎念 | ${SITE_TITLE}`;
const description = '记录生活中的点滴';

// 从 Telegram API 获取数据
const API_URL = 'https://tg-api.050815.xyz/';

// 配置选项（参考 gtalk-frontend）
const CONFIG = {
    // 图片代理配置
    proxy: {
        enabled: true,
        proxyUrl: 'https://tg-api.050815.xyz',
    },
    // 表情反应系统配置
    emaction: {
        enabled: true,
        endpoint: 'https://api-emaction.050815.xyz',
        theme: 'system',
        availableArrayString: '👍,thumbs-up;❤️,heart;😄,smile;🎉,party;🚀,rocket;,joy;😮,wow;😢,sad;😡,angry;🤔,think;👏,clap;🔥,fire;💯,hundred;✨,sparkle;💪,strong;🙏,pray;☕,coffee;🍺,beer',
        threeDimensional: false,
    }
};

interface TelegramMessage {
    id: string;
    text: string;
    image: string[];
    time: number;
    views: string | null;
}

interface TelegramResponse {
    nextBefore: number;
    Region: string;
    version: string;
    ChannelMessageData: Record<string, Omit<TelegramMessage, 'id'>>;
}

let essaysData: TelegramMessage[] = [];
let error: string | null = null;

try {
    const response = await fetch(API_URL);
    if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
    }
    const data: TelegramResponse = await response.json();
    
    // 处理数据：将对象转换为数组并按时间排序（最新的在前）
    essaysData = Object.entries(data.ChannelMessageData)
        .map(([id, message]) => ({ 
            id, 
            ...message 
        }))
        .sort((a, b) => b.time - a.time)
        .map(item => ({
            ...item,
            // 处理文本：移除 SFCN 标签
            text: item.text.replace(/<a[^>]*?(#SFCN|href="[^"]*SFCN[^"]*")[^>]*>.*?<\/a>/gi, ''),
            // 处理图片：应用代理并过滤 emoji 图片
            image: item.image
                .filter(img => !img.includes('telegram.org/img/emoji'))
                .map(img => {
                    // 应用图片代理 - 支持多种 Telegram CDN 域名格式
                    if (CONFIG.proxy.enabled) {
                        // 匹配 cdn*.cdn-telegram.org 和 cdn*.telesco.pe 格式
                        return img.replace(
                            /(https:\/\/cdn\d*\.(?:cdn-telegram\.org|telesco\.pe)\/file\/[^"]+)/g,
                            `${CONFIG.proxy.proxyUrl}/?proxy=$1`
                        );
                    }
                    return img;
                })
        }));
} catch (e) {
    error = e instanceof Error ? e.message : 'Failed to fetch data';
    console.error('Failed to fetch essays:', e);
}

// 格式化日期
function formatDate(timestamp: number): string {
    const date = new Date(timestamp);
    return date.toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
    });
}

// 格式化时间
function formatTime(timestamp: number): string {
    const date = new Date(timestamp);
    return date.toLocaleTimeString('zh-CN', {
        hour: '2-digit',
        minute: '2-digit',
    });
}

// 将 HTML 转换为 Markdown 格式文本
function htmlToMarkdown(html: string): string {
    // 移除 Telegram 的 emoji 图片标签，保留 emoji 字符
    let text = html
        .replace(/<i class="emoji"[^>]*>.*?<b>([^<]*)<\/b>.*?<\/i>/g, '$1')
        .replace(/<br\/>/g, '\n')
        .replace(/<br>/g, '\n')
        .replace(/<hr\/?>/g, '\n---\n')
        .replace(/<b>(.*?)<\/b>/g, '**$1**')
        .replace(/<i>(.*?)<\/i>/g, '*$1*')
        .replace(/<code>(.*?)<\/code>/g, '`$1`')
        .replace(/<pre>(.*?)<\/pre>/gs, '```\n$1\n```')
        .replace(/<a href="([^"]*)"[^>]*>(.*?)<\/a>/g, '[$2]($1)')
        .replace(/<blockquote>(.*?)<\/blockquote>/gs, '> $1')
        .replace(/<h1>(.*?)<\/h1>/g, '# $1\n')
        .replace(/<h2>(.*?)<\/h2>/g, '## $1\n')
        .replace(/<h3>(.*?)<\/h3>/g, '### $1\n');
    
    // 处理无序列表（<ul> 标签包裹的）
    text = text.replace(/<ul>([\s\S]*?)<\/ul>/g, (match, content) => {
        return '\n' + content.replace(/<li>(.*?)<\/li>/g, '- $1\n') + '\n';
    });
    
    // 处理有序列表（<ol> 标签包裹的）
    text = text.replace(/<ol>([\s\S]*?)<\/ol>/g, (match, content) => {
        let index = 1;
        return '\n' + content.replace(/<li>(.*?)<\/li>/g, (match, item) => {
            return `${index++}. ${item}\n`;
        }) + '\n';
    });
    
    // 将 <br/>---<br/> 或换行符包裹的 --- 转换为分隔线
    text = text.replace(/\n---\n/g, '\n\n---\n\n');
    
    // 移除其他 HTML 标签
    text = text.replace(/<[^>]+>/g, '');
    
    // 解码 HTML 实体
    text = text
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&amp;/g, '&')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'");
    
    return text.trim();
}

// 渲染 Markdown 内容
function renderMarkdown(content: string): string {
    const markdownText = htmlToMarkdown(content);
    const rawHtml = marked.parse(markdownText) as string;
    
    // 清理 HTML，只允许安全的标签
    return sanitizeHtml(rawHtml, {
        allowedTags: [
            'p', 'br', 'hr', 'strong', 'b', 'em', 'i', 'u', 'strike', 'del',
            'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
            'ul', 'ol', 'li',
            'blockquote', 'code', 'pre',
            'a', 'img',
            'table', 'thead', 'tbody', 'tr', 'th', 'td'
        ],
        allowedAttributes: {
            'a': ['href', 'title', 'target'],
            'img': ['src', 'alt', 'title'],
            'code': ['class'],
            'pre': ['class'],
            'hr': []
        },
        allowedSchemes: ['http', 'https', 'mailto']
    });
}

// 提取纯文本（用于 alt 属性）
function extractText(html: string): string {
    const text = htmlToMarkdown(html).replace(/[#*_`~\[\]\(\)]/g, '');
    return text.substring(0, 50) + (text.length > 50 ? '...' : '');
}
---

<MainLayout title={title} description={description}>
    <!-- Banner Section -->
    <div class="author-content author-content-item single sharePage" style="background-image: url('https://img.314926.xyz/h')">
        <div class="card-content">
            <div class="author-content-item-tips">分享生活中的小确幸</div>
            <span class="author-content-item-title">碎碎念</span>
        </div>
    </div>

    <div class="essays-container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        {error ? (
            <div class="error-message">
                <p>加载失败：{error}</p>
                <button onclick="window.location.reload()">重新加载</button>
            </div>
        ) : essaysData.length === 0 ? (
            <div class="loading-message">
                <p>加载中...</p>
            </div>
        ) : (
            <div id="essays">
                <section class="timeline">
                    <div class="masonry-grid" id="masonryGrid">
                        {essaysData.map((item, index) => (
                            <div class="masonry-item" data-index={index} data-id={item.id}>
                                <div class="item">
                                    <!-- Content -->
                                    <div class="essay-content">
                                        <div class="datacont markdown-content" set:html={renderMarkdown(item.text)}></div>
                                        
                                        <!-- Images -->
                                        {item.image && item.image.length > 0 && (
                                            <div class="essay-content-img">
                                                {item.image.map((img) => (
                                                    <img src={img} alt={extractText(item.text)} loading="lazy" class="lightbox-img" />
                                                ))}
                                            </div>
                                        )}
                                    </div>

                                    <!-- Emaction 表情反应 -->
                                    {CONFIG.emaction.enabled && (
                                        <div class="emaction-container" data-message-id={item.id}></div>
                                    )}

                                    <!-- Bottom Info -->
                                    <div class="essay-bottom">
                                        <div class="essay-info">
                                            <div class="essay-info-time">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                                                    <line x1="16" x2="16" y1="2" y2="6"/>
                                                    <line x1="8" x2="8" y1="2" y2="6"/>
                                                    <line x1="3" x2="21" y1="10" y2="10"/>
                                                </svg>
                                                <time datetime={new Date(item.time).toISOString()}>
                                                    {formatDate(item.time)} {formatTime(item.time)}
                                                </time>
                                            </div>
                                            {item.views && (
                                                <div class="essay-info-views">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                                        <circle cx="12" cy="12" r="3"/>
                                                    </svg>
                                                    {item.views} 次浏览
                                                </div>
                                            )}
                                        </div>
                                        <button class="essay-comment-btn" aria-label="评论" onclick="document.getElementById('giscus-comments')?.scrollIntoView({ behavior: 'smooth', block: 'start' })">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <!-- Tips -->
                <div id="essays-tips">
                    共 {essaysData.length} 条碎碎念
                </div>

                <!-- Giscus 评论区 -->
                <div id="giscus-comments" class="giscus-container">
                    <div class="giscus-header">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>评论</span>
                    </div>
                    <script src="https://giscus.app/client.js"
                        data-repo="yxksw/Blog"
                        data-repo-id="R_kgDORizo3Q"
                        data-category="评论"
                        data-category-id="DIC_kwDORizo3c4C4OYE"
                        data-mapping="pathname"
                        data-strict="1"
                        data-reactions-enabled="1"
                        data-emit-metadata="0"
                        data-input-position="top"
                        data-theme="preferred_color_scheme"
                        data-lang="zh-CN"
                        data-loading="lazy"
                        crossorigin="anonymous"
                        async>
                    </script>
                </div>
            </div>
        )}
    </div>

    <!-- Lightbox -->
    <div
        id="essays-lightbox"
        class="fixed inset-0 z-[999] hidden items-center justify-center overflow-auto bg-black/70 p-4 md:p-8 dark:bg-black/80"
        aria-hidden="true"
    >
        <button
            id="essays-lightbox-close"
            type="button"
            class="fixed right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/25 bg-black/35 text-white transition-colors hover:bg-black/55"
            aria-label="关闭图片预览"
            data-lightbox-close
        >
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                <path d="M6.7 5.3a1 1 0 0 0-1.4 1.4L10.6 12l-5.3 5.3a1 1 0 1 0 1.4 1.4l5.3-5.3 5.3 5.3a1 1 0 1 0 1.4-1.4L13.4 12l5.3-5.3a1 1 0 0 0-1.4-1.4L12 10.6 6.7 5.3Z" />
            </svg>
        </button>
        <img
            id="essays-lightbox-target"
            src=""
            alt=""
            class="mx-auto block h-auto max-h-[92dvh] max-w-[92vw] rounded-xl object-contain shadow-lg"
        />
    </div>

    <!-- Masonry Layout Script -->
    <script is:inline>
        (function() {
            function initMasonry() {
                const grid = document.getElementById('masonryGrid');
                if (!grid) return;
                
                const items = grid.querySelectorAll('.masonry-item');
                if (items.length === 0) return;
                
                const getColumns = () => {
                    if (window.innerWidth <= 768) return 1;
                    if (window.innerWidth <= 1200) return 2;
                    return 3;
                };
                
                let columns = getColumns();
                const gap = 16;
                
                const columnHeights = new Array(columns).fill(0);
                
                items.forEach((item, index) => {
                    const shortestColumn = columnHeights.indexOf(Math.min(...columnHeights));
                    
                    const columnWidth = (grid.offsetWidth - (columns - 1) * gap) / columns;
                    const left = shortestColumn * (columnWidth + gap);
                    const top = columnHeights[shortestColumn];
                    
                    item.style.position = 'absolute';
                    item.style.left = left + 'px';
                    item.style.top = top + 'px';
                    item.style.width = columnWidth + 'px';
                    
                    columnHeights[shortestColumn] += item.offsetHeight + gap;
                });
                
                const maxHeight = Math.max(...columnHeights);
                grid.style.height = maxHeight + 'px';
            }
            
            const init = () => {
                const grid = document.getElementById('masonryGrid');
                if (grid) {
                    grid.style.position = 'relative';
                    // 立即初始化布局，不等待图片加载
                    initMasonry();
                }
            };
            
            // 立即初始化
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
            
            // 图片加载完成后重新调整布局
            window.addEventListener('load', init);
            
            // 监听图片加载事件，单张图片加载完成后重新布局
            document.addEventListener('load', function(e) {
                if (e.target.tagName === 'IMG' && e.target.closest('#masonryGrid')) {
                    initMasonry();
                }
            }, true);
            
            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(init, 250);
            });
            
            document.addEventListener('astro:page-load', init);
            document.addEventListener('astro:after-swap', init);
        })();
    </script>

    <!-- Lightbox Script -->
    <script is:inline>
        (function() {
            let lockedScrollY = 0;

            const getLightboxElements = () => {
                const overlay = document.getElementById('essays-lightbox');
                const target = document.getElementById('essays-lightbox-target');
                return { overlay, target };
            };

            const closeLightbox = () => {
                const { overlay, target } = getLightboxElements();
                if (!overlay || !target || overlay.classList.contains('hidden')) return;

                overlay.classList.add('hidden');
                overlay.classList.remove('flex');
                overlay.setAttribute('aria-hidden', 'true');
                target.setAttribute('src', '');
                target.setAttribute('alt', '');

                requestAnimationFrame(() => {
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                    window.scrollTo(0, lockedScrollY);
                });
            };

            const openLightbox = (src, altText) => {
                const { overlay, target } = getLightboxElements();
                if (!overlay || !target || !src) return;

                lockedScrollY = window.scrollY;
                const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
                document.body.style.overflow = 'hidden';
                if (scrollbarWidth > 0) {
                    document.body.style.paddingRight = scrollbarWidth + 'px';
                }

                target.setAttribute('src', src);
                target.setAttribute('alt', altText || '');
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
                overlay.setAttribute('aria-hidden', 'false');
            };

            const initLightbox = () => {
                document.addEventListener('click', (event) => {
                    const rawTarget = event.target;
                    if (!(rawTarget instanceof Element)) return;

                    const { overlay } = getLightboxElements();
                    if (overlay && !overlay.classList.contains('hidden')) {
                        if (rawTarget === overlay || rawTarget.closest('[data-lightbox-close]')) {
                            event.preventDefault();
                            closeLightbox();
                            return;
                        }
                    }

                    if (!(rawTarget instanceof HTMLImageElement)) return;
                    if (!rawTarget.classList.contains('lightbox-img')) return;

                    const imgSrc = rawTarget.currentSrc || rawTarget.src;
                    if (!imgSrc) return;
                    openLightbox(imgSrc, rawTarget.alt || '');
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key !== 'Escape') return;
                    closeLightbox();
                });
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLightbox);
            } else {
                initLightbox();
            }

            document.addEventListener('astro:page-load', initLightbox);
            document.addEventListener('astro:after-swap', initLightbox);
        })();
    </script>

    <!-- Emaction 表情反应系统 -->
    {CONFIG.emaction.enabled && (
        <script is:inline define:vars={{ config: CONFIG.emaction }}>
            (function() {
                const DEFAULT_EMOJIS = "👍,thumbs-up;😄,smile-face;🎉,party-popper;😕,confused-face;❤️,red-heart;🚀,rocket;👀,eyes;👎,thumbs-down;";
                
                class EmactionExpress {
                    constructor(container, messageId) {
                        this.container = container;
                        this.messageId = messageId;
                        this.reactTargetId = 'tgtalk-evaluate-id-' + messageId;
                        this.showAvailable = false;
                        this.availableReactions = [];
                        this.endpoint = config.endpoint;
                        this.theme = config.theme;
                        this.threeDimensional = config.threeDimensional;
                        this.availableArrayString = config.availableArrayString || DEFAULT_EMOJIS;
                        
                        this.init();
                    }
                    
                    async init() {
                        await this.initReactions();
                        this.render();
                    }
                    
                    parseAvailableReactions() {
                        const arrString = this.availableArrayString || DEFAULT_EMOJIS;
                        return arrString
                            .split(";")
                            .map((val) => {
                                const [emoji, reactionName] = val.split(",");
                                if (!emoji || !reactionName) return null;
                                return { emoji, reaction_name: reactionName, count: 0, meReacted: false };
                            })
                            .filter((val) => val);
                    }
                    
                    async initReactions() {
                        this.availableReactions = this.parseAvailableReactions();
                        
                        try {
                            // 获取已有反应数量
                            const response = await fetch(
                                `${this.endpoint}/reactions?${new URLSearchParams({ targetId: this.reactTargetId })}`
                            );
                            const data = await response.json();
                            
                            if (data.data && Array.isArray(data.data.reactionsGot)) {
                                data.data.reactionsGot.forEach((reaction) => {
                                    this.availableReactions.forEach((availableReaction) => {
                                        if (reaction.reaction_name === availableReaction.reaction_name) {
                                            availableReaction.count = reaction.count;
                                        }
                                    });
                                });
                            }
                            
                            // 读取 localStorage 获取用户已点击的反应
                            const storageKey = `meReactedReactions_${this.reactTargetId}`;
                            const meReactedReactions = JSON.parse(localStorage.getItem(storageKey) || "[]");
                            meReactedReactions.forEach((reaction_name) => {
                                this.availableReactions.forEach((availableReaction) => {
                                    if (reaction_name === availableReaction.reaction_name) {
                                        availableReaction.meReacted = true;
                                    }
                                });
                            });
                        } catch (err) {
                            console.error('Failed to fetch reactions:', err);
                        }
                    }
                    
                    async react(reactionName) {
                        const reaction = this.availableReactions.find((ele) => ele.reaction_name === reactionName);
                        if (!reaction) return;
                        
                        const cancel = reaction.meReacted;
                        const count = Math.max(0, reaction.count + (cancel ? -1 : 1));
                        reaction.count = count;
                        reaction.meReacted = !cancel;
                        this.showAvailable = false;
                        
                        // 更新 localStorage
                        const storageKey = `meReactedReactions_${this.reactTargetId}`;
                        const meReactedReactionsSet = new Set(JSON.parse(localStorage.getItem(storageKey) || "[]"));
                        if (cancel) {
                            meReactedReactionsSet.delete(reactionName);
                        } else {
                            meReactedReactionsSet.add(reactionName);
                        }
                        localStorage.setItem(storageKey, JSON.stringify(Array.from(meReactedReactionsSet)));
                        
                        // 发送请求
                        try {
                            await fetch(
                                `${this.endpoint}/reaction?${new URLSearchParams({
                                    targetId: this.reactTargetId,
                                    reaction_name: reactionName,
                                    diff: cancel ? -1 : 1,
                                })}`,
                                { method: "PATCH" }
                            );
                        } catch (err) {
                            console.error('Failed to update reaction:', err);
                        }
                        
                        this.render();
                    }
                    
                    getSystemTheme() {
                        return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
                    }
                    
                    isDarkTheme() {
                        return this.theme === "dark" || (this.theme === "system" && this.getSystemTheme() === "dark");
                    }
                    
                    render() {
                        const isDark = this.isDarkTheme();
                        const containerClass = isDark ? "emaction-container-dark" : "emaction-container-light";
                        const fontFamily = this.threeDimensional ? '"Emoji Font", system-ui' : 'system-ui';
                        
                        const reactedReactions = this.availableReactions.filter(r => r.count > 0);
                        
                        this.container.innerHTML = `
                            <div class="emaction-express ${containerClass}" style="font-family: ${fontFamily}; display: flex; flex-wrap: wrap; gap: 0.375rem; align-items: center;">
                                <div style="position: relative; user-select: none;">
                                    <div class="emaction-add-btn" style="display: flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; cursor: pointer; border: 1px solid ${isDark ? '#30363d' : '#d0d7de'}; background: ${isDark ? '#21262d' : '#f6f8fa'};">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" style="fill: ${isDark ? '#7d8590' : '#656d76'};">
                                            <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm3.82 1.636a.75.75 0 0 1 1.038.175l.007.009c.103.118.22.222.35.31.264.178.683.37 1.285.37.602 0 1.02-.192 1.285-.371.13-.088.247-.192.35-.31l.007-.008a.75.75 0 0 1 1.222.87l-.022-.015c.02.013.021.015.021.015v.001l-.001.002-.002.003-.005.007-.014.019a2.066 2.066 0 0 1-.184.213c-.16.166-.338.316-.53.445-.63.418-1.37.638-2.127.629-.946 0-1.652-.308-2.126-.63a3.331 3.331 0 0 1-.715-.657l-.014-.02-.005-.006-.002-.003v-.002h-.001l.613-.432-.614.43a.75.75 0 0 1 .183-1.044ZM12 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM5 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm5.25 2.25.592.416a97.71 97.71 0 0 0-.592-.416Z"></path>
                                        </svg>
                                    </div>
                                    <div class="emaction-popup" style="display: none; position: absolute; bottom: 100%; left: 0; margin-bottom: 0.5rem; padding: 0.5rem; background: ${isDark ? '#161b22' : '#fff'}; border: 1px solid ${isDark ? '#30363d' : '#d0d7de'}; border-radius: 0.5rem; box-shadow: 0 8px 24px rgba(0,0,0,0.2); z-index: 9999; min-width: 200px; max-width: 280px;">
                                        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.25rem;">
                                            ${this.availableReactions.map((r) => `
                                                <span class="emaction-emoji ${r.meReacted ? 'reacted' : ''}" data-reaction="${r.reaction_name}" style="cursor: pointer; padding: 0.5rem; border-radius: 0.375rem; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; ${r.meReacted ? `background: ${isDark ? '#388bfd1a' : '#ddf4ff'};` : ''}">${r.emoji}</span>
                                            `).join('')}
                                        </div>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;">
                                    ${reactedReactions.map(r => `
                                        <div class="emaction-reaction ${r.meReacted ? 'reacted' : 'not-reacted'}" data-reaction="${r.reaction_name}" style="display: flex; align-items: center; gap: 0.25rem; padding: 0.125rem 0.5rem; border-radius: 1rem; font-size: 0.75rem; cursor: pointer; border: 1px solid ${r.meReacted ? (isDark ? '#1f6feb' : '#0969da') : (isDark ? '#30363d' : '#d0d7de')}; background: ${r.meReacted ? (isDark ? '#388bfd1a' : '#ddf4ff') : (isDark ? 'transparent' : '#fff')}; color: ${r.meReacted ? (isDark ? '#2f81f7' : '#0969da') : (isDark ? '#7d8590' : '#656d76')};">
                                            <span>${r.emoji}</span>
                                            <span>${r.count}</span>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        `;
                        
                        this.attachEvents();
                    }
                    
                    attachEvents() {
                        const addBtn = this.container.querySelector('.emaction-add-btn');
                        const popup = this.container.querySelector('.emaction-popup');
                        
                        if (addBtn && popup) {
                            addBtn.addEventListener('click', (e) => {
                                e.stopPropagation();
                                this.showAvailable = !this.showAvailable;
                                popup.style.display = this.showAvailable ? 'block' : 'none';
                            });
                            
                            popup.querySelectorAll('.emaction-emoji').forEach(emoji => {
                                emoji.addEventListener('click', (e) => {
                                    e.stopPropagation();
                                    const reactionName = emoji.dataset.reaction;
                                    this.react(reactionName);
                                });
                            });
                        }
                        
                        this.container.querySelectorAll('.emaction-reaction').forEach(reaction => {
                            reaction.addEventListener('click', (e) => {
                                e.stopPropagation();
                                const reactionName = reaction.dataset.reaction;
                                this.react(reactionName);
                            });
                        });
                        
                        // 点击外部关闭 popup
                        const closePopup = (e) => {
                            if (!this.container.contains(e.target)) {
                                this.showAvailable = false;
                                if (popup) popup.style.display = 'none';
                            }
                        };
                        document.removeEventListener('click', closePopup);
                        document.addEventListener('click', closePopup);
                    }
                }
                
                const initEmaction = () => {
                    const containers = document.querySelectorAll('.emaction-container');
                    containers.forEach(container => {
                        const messageId = container.dataset.messageId;
                        if (!messageId || container.dataset.emactionInitialized) return;
                        
                        new EmactionExpress(container, messageId);
                        container.dataset.emactionInitialized = 'true';
                    });
                };
                
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initEmaction);
                } else {
                    initEmaction();
                }
                
                document.addEventListener('astro:page-load', initEmaction);
            })();
        </script>
    )}
</MainLayout>

