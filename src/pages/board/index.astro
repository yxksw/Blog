---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import MobileDrawer from '../../components/MobileDrawer.astro';
import TalkLoading from '../../components/board/TalkLoading.astro';
import TalkSpinner from '../../components/board/TalkSpinner.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const title = `说说 | ${SITE_TITLE}`;
const description = '记录生活点滴，分享瞬间感悟';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title={title} description={description} />
  <link rel="stylesheet" href="/shuoshuo.css" />
  <!-- marked.js for Markdown rendering -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked@9.1.6/marked.min.js"></script>
  <!-- Iconify for icons -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    /* 页面标题样式 */
    .board-header {
      text-align: center;
      padding: 3rem 1rem 2rem;
      position: relative;
    }

    .board-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .dark .board-title {
      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .board-subtitle {
      font-size: 1rem;
      color: #6b7280;
      max-width: 500px;
      margin: 0 auto;
    }

    .dark .board-subtitle {
      color: #9ca3af;
    }

    /* 说说容器 */
    .board-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1rem 4rem;
      min-height: 50vh;
    }

    /* 加载状态样式 */
    #talk.talk-pending {
      visibility: hidden;
      min-height: 180px;
    }

    /* 限制提示 */
    .limit-notice {
      width: 100%;
      text-align: center;
      margin: 30px 0;
      position: relative;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--liushen-text);
    }

    .limit-notice:before, .limit-notice:after {
      content: "";
      position: absolute;
      top: 50%;
      width: 30%;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(125, 125, 125, 0.5));
    }

    .limit-notice:before {
      left: 0;
    }

    .limit-notice:after {
      right: 0;
      background: linear-gradient(to left, transparent, rgba(125, 125, 125, 0.5));
    }

    .limit-notice span {
      background-color: var(--liushen-card-bg);
      padding: 0 20px;
      font-size: 0.9rem;
      color: #888;
      position: relative;
      z-index: 1;
    }

    /* Giscus 评论区样式 */
    .giscus-section {
      max-width: 1200px;
      margin: 3rem auto 0;
      padding: 0 1rem;
    }

    .giscus-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--liushen-border, #e5e7eb);
      color: var(--liushen-text, #374151);
      font-size: 1.25rem;
      font-weight: 600;
    }

    .dark .giscus-header {
      color: var(--liushen-text, #e5e7eb);
      border-bottom-color: var(--liushen-border, rgba(255,255,255,0.1));
    }

    .giscus-header svg {
      color: #3b82f6;
    }

    .giscus-container {
      background: var(--liushen-card-bg, white);
      border-radius: 1rem;
      padding: 1.5rem;
      border: 1px solid var(--liushen-border, #e5e7eb);
    }

    .dark .giscus-container {
      background: var(--liushen-card-bg, rgba(255,255,255,0.05));
      border-color: var(--liushen-border, rgba(255,255,255,0.1));
    }

    @media (max-width: 640px) {
      .giscus-section {
        margin-top: 2rem;
        padding: 0 0.75rem;
      }

      .giscus-container {
        padding: 1rem;
        border-radius: 0.75rem;
      }

      .giscus-header {
        font-size: 1.1rem;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
      }
    }

    /* Markdown 内容样式 */
    .talk_content_text h1,
    .talk_content_text h2,
    .talk_content_text h3,
    .talk_content_text h4 {
      margin: 0.75rem 0 0.5rem;
      font-weight: 600;
    }

    .talk_content_text h1 { font-size: 1.5rem; }
    .talk_content_text h2 { font-size: 1.3rem; }
    .talk_content_text h3 { font-size: 1.1rem; }
    .talk_content_text h4 { font-size: 1rem; }

    .talk_content_text p {
      margin: 0.5rem 0;
    }

    .talk_content_text ul,
    .talk_content_text ol {
      margin: 0.5rem 0;
      padding-left: 1.5rem;
    }

    .talk_content_text li {
      margin: 0.25rem 0;
    }

    .talk_content_text blockquote {
      border-left: 3px solid rgba(194, 166, 97, 0.85);
      padding-left: 1rem;
      margin: 0.5rem 0;
      color: var(--liushen-text);
      opacity: 0.8;
    }

    .talk_content_text code {
      background: var(--liushen-card-secondbg);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.875em;
    }

    .talk_content_text pre {
      background: var(--liushen-card-secondbg);
      padding: 1rem;
      border-radius: 0.5rem;
      overflow-x: auto;
      margin: 0.5rem 0;
    }

    .talk_content_text pre code {
      background: none;
      padding: 0;
    }

    .talk_content_text img {
      max-width: 100%;
      border-radius: 8px;
      cursor: zoom-in;
    }

    .talk_content_text a {
      color: var(--liushen-link-color);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }

    .talk_content_text a:hover {
      border-bottom-color: var(--liushen-link-color);
    }

    /* 响应式 */
    @media (max-width: 640px) {
      .board-header {
        padding: 1.5rem 0.75rem 1rem;
      }

      .board-title {
        font-size: 1.75rem;
      }

      .board-subtitle {
        font-size: 0.875rem;
        padding: 0 1rem;
      }

      .board-container {
        padding: 0 0 2rem;
      }

      .limit-notice {
        margin: 20px 0;
        height: 32px;
      }

      .limit-notice span {
        font-size: 0.8rem;
        padding: 0 15px;
      }

      .limit-notice:before,
      .limit-notice:after {
        width: 20%;
      }

      .talk_content_text h1 { font-size: 1.1rem; }
      .talk_content_text h2 { font-size: 1rem; }
      .talk_content_text h3 { font-size: 0.95rem; }
      .talk_content_text h4 { font-size: 0.9rem; }

      .talk_content_text ul,
      .talk_content_text ol {
        padding-left: 1.25rem;
      }

      .talk_content_text pre {
        padding: 0.75rem;
      }
    }
  </style>
</head>
<body class="bg-zinc-50 dark:bg-zinc-900">
  <Header />
  <MobileDrawer />

  <main class="min-h-screen">
    <!-- 页面标题 -->
    <div class="board-header">
      <h1 class="board-title">💭 说说</h1>
      <p class="board-subtitle">记录生活点滴，分享瞬间感悟</p>
    </div>

    <!-- 说说容器 -->
    <div class="board-container">
      <!-- 骨架屏加载 - 初始显示 -->
      <TalkLoading />
      
      <!-- 加载动画 - 数据获取时显示 -->
      <div id="talk-spinner" hidden>
        <TalkSpinner />
      </div>
      
      <!-- 说说列表 - 瀑布流 -->
      <div id="talk" class="talk-pending"></div>
      
      <!-- 限制提示 -->
      <div class="limit-notice">
        <span>仅展示最近15条说说</span>
      </div>

      <!-- Giscus 评论区 -->
      <div id="giscus-section" class="giscus-section">
        <div class="giscus-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>评论交流</span>
        </div>
        <div class="giscus-container">
          <script src="https://giscus.app/client.js"
            data-repo="yxksw/Blog"
            data-repo-id="R_kgDORizo3Q"
            data-category="评论"
            data-category-id="DIC_kwDORizo3c4C4OYE"
            data-mapping="pathname"
            data-strict="1"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
          </script>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <!-- 灯箱组件 -->
  <div
    id="img-lightbox"
    class="fixed inset-0 z-[999] hidden items-center justify-center overflow-auto bg-black/70 p-4 md:p-8 dark:bg-black/80"
    aria-hidden="true"
  >
    <button
      id="img-lightbox-close"
      type="button"
      class="fixed right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/25 bg-black/35 text-white transition-colors hover:bg-black/55"
      aria-label="Close image preview"
      data-lightbox-close
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
        <path d="M6.7 5.3a1 1 0 0 0-1.4 1.4L10.6 12l-5.3 5.3a1 1 0 1 0 1.4 1.4l5.3-5.3 5.3 5.3a1 1 0 1 0 1.4-1.4L13.4 12l5.3-5.3a1 1 0 0 0-1.4-1.4L12 10.6 6.7 5.3Z" />
      </svg>
    </button>
    <img
      id="img-lightbox-target"
      src=""
      alt=""
      class="mx-auto block h-auto max-h-[92dvh] max-w-[92vw] rounded-xl object-contain shadow-lg"
    />
  </div>

  <!-- 说说脚本 -->
  <script is:inline src="/shuoshuo.js"></script>

  <!-- Giscus 主题切换适配 -->
  <script is:inline>
    (function() {
      // 发送主题消息给 Giscus
      function sendGiscusTheme(theme) {
        const iframe = document.querySelector('iframe.giscus-frame');
        if (iframe) {
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: theme } } },
            'https://giscus.app'
          );
        }
      }

      // 获取当前主题
      function getCurrentTheme() {
        const stored = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored === 'dark' || stored === 'light' ? stored : systemPrefersDark ? 'dark' : 'light';
        return theme;
      }

      // 更新 Giscus 主题
      function updateGiscusTheme() {
        const theme = getCurrentTheme();
        // Giscus 主题名称映射
        const giscusTheme = theme === 'dark' ? 'dark' : 'light';
        sendGiscusTheme(giscusTheme);
      }

      // 监听主题变化
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.attributeName === 'class') {
            updateGiscusTheme();
          }
        });
      });

      // 开始监听 html 元素的 class 变化
      observer.observe(document.documentElement, { attributes: true });

      // 页面加载时设置初始主题
      document.addEventListener('DOMContentLoaded', updateGiscusTheme);
      document.addEventListener('astro:page-load', updateGiscusTheme);

      // 监听 Giscus 加载完成
      window.addEventListener('message', function(event) {
        if (event.origin !== 'https://giscus.app') return;
        if (event.data && event.data.giscus) {
          // Giscus 加载完成，设置主题
          updateGiscusTheme();
        }
      });
    })();
  </script>
</body>
</html>
