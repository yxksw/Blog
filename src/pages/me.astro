    rightTags: ['二次元', '开源爱好者']
  },
  
  // 内容信息
  contentInfo: {
    sup: '你好，很高兴认识你',
    name: '云曦',
    title: '是一名 计算机爱好者、博主',
    tip: 'Slogan',
    slogan: '在',
    mask: ['不断探索中', '热爱生活', '追求极致', '创造价值']
  },
  
  // 技能信息
  skills: {
    title: '技能',
    subtitle: '开启创造力',
    tags: [
      { title: 'JavaScript', color: '#f7df1e', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg' },
      { title: 'TypeScript', color: '#3178c6', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg' },
      { title: 'React', color: '#61dafb', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg' },
      { title: 'Vue', color: '#4fc08d', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg' },
      { title: 'Node.js', color: '#339933', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg' },
      { title: 'Python', color: '#3776ab', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg' },
      { title: 'Docker', color: '#2496ed', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg' },
      { title: 'Linux', color: '#fcc624', img: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg' },
    ]
  },
  
  // 职业经历
  careers: {
    title: '生涯',
    subtitle: '无限进步',
    image: 'https://bu.dusays.com/2026/02/27/69a14e1fe4fef.webp',
    items: [
      { school: '某某大学', major: '计算机科学与技术', color: '#3b82f6' },
      { school: '某某高中', major: '理科', color: '#10b981' }
    ]
  },
  
  // 性格
  personalities: {
    tips: '性格',
    title: '提倡者',
    type: 'INFJ-T',
    color: '#1AED66',
    image: 'https://cdn.jsdmirror.com/gh/zsxcoder/github-img@main/img/infj.avif',
    myphoto: 'https://s2.loli.net/2024/11/10/mGboP27FOzaQHRp.webp',
    linkText: '16personalities',
    typeName: 'INFJ-T',
    typeLink: 'https://www.16personalities.com/infj-personality'
  },
  
  // 座右铭
  motto: {
    title: '座右铭',
    prefix: '每一段旅行',
    content: '都有重点'
  },
  
  // 专长
  expertise: {
    title: '专长',
    prefix: '专注于',
    specialist: 'Web开发',
    content: '热爱',
    level: '开源贡献'
  },
  
  // 游戏
  games: [
    {
      type: 'game',
      title: '游戏爱好',
      subtitle: '原神',
      img: 'https://cdn.jsdelivr.net/gh/yxksw/blog-img@main/game-genshin.jpg',
      tips_left: 'UID: 123456789'
    },
    {
      type: 'game',
      title: '游戏爱好',
      subtitle: '崩坏：星穹铁道',
      img: 'https://cdn.jsdelivr.net/gh/yxksw/blog-img@main/game-starrail.jpg',
      tips_left: 'UID: 100122444'
    },
    {
      type: 'game',
      title: '游戏爱好',
      subtitle: '第五人格',
      img: 'https://cdn.jsdelivr.net/gh/yxksw/blog-img@main/game-identity5.jpg',
      tips_left: 'ID: 442106279'
    }
  ],
  
  // 爱好
  likes: [
    {
      type: 'like-technology',
