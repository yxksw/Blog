---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';
import AuthorInfo from '../components/about/AuthorInfo.astro';
import ContentInfo from '../components/about/ContentInfo.astro';
import SkillsInfo from '../components/about/SkillsInfo.astro';
import Personalities from '../components/about/Personalities.astro';
import Motto from '../components/about/Motto.astro';
import Hobbies from '../components/about/Hobbies.astro';
import Award from '../components/about/Award.astro';
import Other from '../components/about/Other.astro';
import TenYear from '../components/about/TenYear.astro';

const title = `关于 | ${SITE_TITLE}`;
const description = '了解更多关于我的信息';

// 关于页面数据配置
const aboutData = {
  // 作者信息
  authorInfo: {
    title: '关于',
