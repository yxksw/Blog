---

<MainLayout title={title} description={description}>
  <div id="about-page">
    <!-- 作者信息 -->
    <AuthorInfo data={aboutData.authorInfo} title={aboutData.authorInfo.title} />
    
    <!-- 内容信息 -->
    <ContentInfo data={aboutData.contentInfo} />
    
    <!-- 技能和职业 -->
    <SkillsInfo skills={aboutData.skills} careers={aboutData.careers} />
    
    <!-- 性格和个人照片 -->
    <Personalities data={aboutData.personalities} />
    
    <!-- 座右铭和专长 -->
    <Motto motto={aboutData.motto} expertise={aboutData.expertise} />
    
    <!-- 游戏 -->
    <Hobbies games={aboutData.games} />
    
    <!-- 爱好 -->
    <Hobbies likes={aboutData.likes} />
    
    <!-- 统计和个人信息 -->
    <Other tj={aboutData.tj} oneself={aboutData.oneself} />
    
    <!-- 建站原因 -->
    {aboutData.cause && (
      <div class="author-content">
        <div class="create-site-post author-content-item single">
          <div class="author-content-item-tips">{aboutData.cause.tip}</div>
          <span class="author-content-item-title">{aboutData.cause.title}</span>
          <div class="lishi">博客发展历程</div>
          <ul class="timeline">
            {aboutData.cause.timeline.map((item) => (
              <li>
                <div class="timeline-version">{item.version}</div>
                <div class="timeline-content">{item.content}</div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
    
    <!-- 十年计划 -->
    <TenYear data={aboutData.tenyear} />
    
    <!-- 打赏 -->
    <Award data={aboutData.award} sponsorsUrl={aboutData.sponsorsUrl} />
  </div>
</MainLayout>

<style is:global>
  /* 基础样式 - 使用 AstraBay 的 CSS 变量 */
  #about-page {
    display: flex;
    padding-top: 1rem;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1rem 4rem;
  }

  /* 通用内容块 */
  .author-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: stretch;
    width: 100%;
    gap: 0.5rem;
  }

  .author-content-item {
    flex: 1;
    min-height: 200px;
    border-radius: 24px;
    background: var(--efu-card-bg, #fff);
    border: 1px solid var(--efu-card-border, #e3e8f7);
    box-shadow: var(--efu-shadow-border, 0 8px 16px -4px #2c2d300c);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    padding: 2rem;
  }

  [data-theme="dark"] .author-content-item {
    background: var(--efu-card-bg, #1b1c20);
    border-color: var(--efu-card-border, #3d3d3f);
  }

  .author-content-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--efu-shadow-border, 0 8px 16px -4px #2c2d300c), 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .author-content-item.single {
    flex: 1 1 100%;
  }

  .author-content-item-tips {
    font-size: 0.75rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
    color: var(--efu-secondtext, rgba(60, 60, 67, 0.8));
  }

  [data-theme="dark"] .author-content-item-tips {
    color: var(--efu-secondtext, rgba(255, 255, 255, 0.7));
  }

  .author-content-item-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--efu-fontcolor, #363636);
  }

  [data-theme="dark"] .author-content-item-title {
    color: var(--efu-fontcolor, #f7f7fa);
  }

  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .content-bottom {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tips {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  /* 时间线样式 */
  .lishi {
    font-size: 1.25rem;
    color: var(--efu-secondtext, #6b7280);
    margin: 1rem 0;
  }

  [data-theme="dark"] .lishi {
    color: var(--efu-secondtext, #9ca3af);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline li {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 1.5rem;
    border-left: 2px solid var(--efu-card-border, #e5e7eb);
  }

  [data-theme="dark"] .timeline li {
    border-left-color: rgba(255, 255, 255, 0.1);
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3b82f6;
  }

  .timeline li:last-child {
    border-left: 2px solid transparent;
  }

  .timeline-version {
    font-weight: 700;
    color: #3b82f6;
    margin-bottom: 0.25rem;
  }

  .timeline-content {
    color: var(--efu-fontcolor, #4b5563);
    line-height: 1.6;
  }

  [data-theme="dark"] .timeline-content {
    color: var(--efu-fontcolor, #9ca3af);
  }

  /* 按钮样式 */
  .banner-button-group {
    display: flex;
    gap: 0.5rem;
  }

  .banner-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    transition: all 0.3s ease;
  }

  .banner-button:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateX(4px);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    #about-page {
      padding: 0.5rem 0.75rem 2rem;
      gap: 0.75rem;
    }

    .author-content {
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .author-content-item {
      flex: 1 1 100% !important;
      width: 100% !important;
      min-height: 140px;
      padding: 1.25rem;
      border-radius: 16px;
    }
    
    .author-content-item-title {
      font-size: 1.25rem;
    }

    .author-content-item-tips {
      font-size: 0.7rem;
    }

    .card-content {
      padding: 0;
    }

    .content-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .banner-button-group {
      width: 100%;
    }

    .banner-button {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .author-content-item {
      padding: 1rem;
      min-height: 120px;
    }

    .author-content-item-title {
      font-size: 1.1rem;
    }
  }

  /* 动画 */
  @keyframes gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes floating {
    0%, 100% { transform: translate(0, -4px); }
    50% { transform: translate(0, 4px); }
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .author-content-item {
    animation: slide-in 0.6s ease backwards;
  }

  .author-content-item:nth-child(1) { animation-delay: 0s; }
  .author-content-item:nth-child(2) { animation-delay: 0.1s; }
  .author-content-item:nth-child(3) { animation-delay: 0.2s; }
  .author-content-item:nth-child(4) { animation-delay: 0.3s; }
</style>
