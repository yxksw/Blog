import ContentInfo from '../components/about/ContentInfo.astro';
import SkillsInfo from '../components/about/SkillsInfo.astro';
import Personalities from '../components/about/Personalities.astro';
import Motto from '../components/about/Motto.astro';
import Hobbies from '../components/about/Hobbies.astro';
import Award from '../components/about/Award.astro';
import Other from '../components/about/Other.astro';
import TenYear from '../components/about/TenYear.astro';
import { getCollection } from 'astro:content';

const title = `关于 | ${SITE_TITLE}`;
const description = '了解更多关于我的信息';

// 获取 about.mdx 内容
const aboutEntries = await getCollection('about');
const aboutDoc = aboutEntries.find(entry => entry.id === 'about.mdx' || entry.id === 'about.md') || aboutEntries[0];
const aboutContent = aboutDoc?.body || '';

// 解析时间线数据
function parseTimeline(content: string) {
  const lines = content.split('\n').filter(line => line.trim());
  const timeline: { version: string; content: string }[] = [];
  let currentItem: { version: string; content: string } | null = null;
  
  for (const line of lines) {
    const versionMatch = line.match(/^-\s*(V\d+\s+\d{4})/);
    if (versionMatch) {
      if (currentItem) {
        timeline.push(currentItem);
      }
      currentItem = {
        version: versionMatch[1],
        content: ''
      };
    } else if (currentItem && line.trim()) {
      currentItem.content += (currentItem.content ? ' ' : '') + line.trim();
    }
  }
  if (currentItem) {
    timeline.push(currentItem);
  }
  return timeline;
}

const timelineData = parseTimeline(aboutContent);

// 关于页面数据配置
