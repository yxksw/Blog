---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import NewPostNotification from '../components/NewPostNotification.astro';
import PostCard from '../components/PostCard.astro';
import TerminalQuote from '../components/TerminalQuote.astro';
import { BILIBILI_URL, TELEGRAM_URL, EMAIL_URL, QQ_URL, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const BASE = import.meta.env.BASE_URL;
// Keep home preview aligned with list pagination size for consistent editorial cadence.
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const HOME_WALLPAPER = 'https://img.314926.xyz/h';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<MobileDrawer />
		<NewPostNotification />
		<main class="page-shell page-fade-in py-10 md:py-14" transition:name="page-main" transition:animate="fade">
			<div class="space-y-6">
				<section class="hero-enter overflow-hidden rounded-2xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-900">
					<div class="relative h-[44vh] min-h-[300px] w-full">
						<img
							src={HOME_WALLPAPER}
							alt="Homepage wallpaper"
							class="h-full w-full object-cover object-[77%_center] md:object-center"
						/>
						<div class="absolute inset-0 bg-zinc-900/10 dark:bg-zinc-950/25"></div>
					</div>
				</section>

				<section class="section-enter section-enter-delay-1 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 items-start">
					<div class="hero-enter hero-enter-delay-2">
						<h1 class="font-sans text-3xl font-semibold leading-tight tracking-tight text-zinc-900 dark:text-zinc-100 md:text-4xl" transition:name="page-title" transition:animate="fade">
							{SITE_TITLE}
						</h1>
						<p class="mt-2 font-sans text-sm text-zinc-500 dark:text-zinc-400">欢迎来到我的博客~</p>
						<p class="mt-1 font-sans text-sm text-zinc-500 dark:text-zinc-400">{SITE_DESCRIPTION}</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<span class="rounded-lg border border-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
								博客写作者
							</span>
							<span class="rounded-lg border border-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
								前端入门者
							</span>
						</div>
						<div class="mt-4 flex items-center gap-2">
							<a
								href={GITHUB_URL}
								target="_blank"
								rel="noreferrer"
								class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
								aria-label="GitHub"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path fill="#ea580c" d="M5 2h4v2H7v2H5zm0 10H3V6h2zm2 2H5v-2h2zm2 2v-2H7v2H3v-2H1v2h2v2h4v4h2v-4h2v-2zm0 0v2H7v-2zm6-12v2H9V4zm4 2h-2V4h-2V2h4zm0 6V6h2v6zm-2 2v-2h2v2zm-2 2v-2h2v2zm0 2h-2v-2h2zm0 0h2v4h-2z"/></svg>
								<span class="sr-only">GitHub</span>
							</a>
							<a
								href={BILIBILI_URL}
								target="_blank"
								rel="noreferrer"
								class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
								aria-label="Bilibili"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="#0284c7" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M4.903 6.934h14.155s1.467 0 1.467 1.468v9.273s0 1.468-1.467 1.468H4.903s-1.468 0-1.468-1.468V8.402s0-1.468 1.468-1.468"/><path d="M14.725 15.839c-.06.27-.35.619-.998.619c-1.178 0-1.707-1.468-1.707-1.468s-.53 1.468-1.707 1.468c-.689 0-.998-.35-.998-.62"/><path d="M4.653 4.25A3.913 3.913 0 0 0 .75 8.161v9.763a3.903 3.903 0 0 0 3.903 3.903h.998v.22a1.228 1.228 0 0 0 2.446 0v-.25h7.806v.25a1.227 1.227 0 0 0 2.446 0v-.25h.998a3.903 3.903 0 0 0 3.903-3.903V8.162a3.913 3.913 0 0 0-3.903-3.913zm1.068 7.426l3.843-.779m8.675.779l-3.843-.779M6.12.835L9.534 4.25M17.84.835L14.426 4.25"/></g></svg>
								<span class="sr-only">Bilibili</span>
							</a>
							<a
							href={TELEGRAM_URL}
							target="_blank"
							rel="noreferrer"
							class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
							aria-label="Telegram"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 12 12"><path fill="#0284c7" d="M10 11h1V1h-1v1H8v1h1v1h1v5H8v1h2ZM0 7h2V6H0Zm4 5h1v-1h1v-1H5V8h1V7H2v1h2ZM2 6h2V5H2Zm4 4h1V9h1V8H6Zm0-3h1V6H6ZM4 5h2V4H4Zm3 1h1V5H7ZM6 4h2V3H6Zm2 1h1V4H8Zm0 0"/></svg>
							<span class="sr-only">Telegram</span>
						</a>
						<a
							href={QQ_URL}
							target="_blank"
							rel="noreferrer"
							class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
							aria-label="QQ"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 12 12"><path fill="currentColor" d="M2 6H1v1H0v3h1V9h1Zm0 0h1V5h5v1h1V3H8V2H7V1H4v1H3v1H2Zm0 4h1V9H2Zm0 2h2v-1h3v1h2v-1H8v-1H3v1H2Zm2-3h2V7h2V6H3v1h1Zm4 1h1V9H8ZM4 4V3h1v1Zm6 6h1V7h-1V6H9v3h1ZM6 4V3h1v1Zm0 0"/></svg>
							<span class="sr-only">QQ</span>
						</a>
						<a
							href={EMAIL_URL}
							class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
							aria-label="Email"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18.5" height="17" x="2.682" y="3.5" rx="4"/><path stroke-linecap="round" stroke-linejoin="round" d="m2.729 7.59l7.205 4.13a3.96 3.96 0 0 0 3.975 0l7.225-4.13"/></g></svg>
							<span class="sr-only">Email</span>
						</a>
						</div>
					</div>

					<div class="hero-enter hero-enter-delay-2 w-full max-w-sm justify-self-end">
						<TerminalQuote />
					</div>
				</section>
			</div>

			<section class="section-enter section-enter-delay-2 mt-10">
				<div class="mb-4 flex items-center justify-between">
					<h2 class="text-xl font-semibold tracking-tight">最新文章</h2>
					<a
						href={`${BASE}blog/`}
						class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300/90 bg-zinc-50/96 px-3 py-1.5 text-sm font-medium text-zinc-700 no-underline transition-colors duration-150 ease-out hover:border-zinc-400 hover:bg-white hover:text-zinc-900 dark:border-zinc-700/90 dark:bg-zinc-900/96 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
					>
						<span>全部文章</span>
						<svg viewBox="0 0 20 20" class="h-4 w-4 opacity-75" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<path d="M4.75 10h10.5" stroke-linecap="round" />
							<path d="M10.75 5.5 15.25 10l-4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>
				<ul class="grid gap-4 md:grid-cols-2">
					{
						posts.map((post, idx) => (
							<li class="card-enter relative" style={`animation-delay: ${160 + idx * 45}ms`}>
								<PostCard
									post={post}
									base={BASE}
									titleTag="h3"
									titleClass="mt-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
									descriptionClass="mt-2 font-serif text-sm leading-7 text-zinc-600 dark:text-zinc-300"
									maxMobile={3}
									maxDesktop={3}
									reloadOnNavigate={true}
								/>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>



