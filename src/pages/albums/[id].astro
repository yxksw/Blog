---
export const prerender = true;

import MainLayout from '../../layouts/MainLayout.astro';
import { SITE_TITLE } from '../../consts';
import { scanAlbums } from '../../utils/album-scanner';
import type { Photo } from '../../types/album';

// 导入 Fancybox CSS
import '@fancyapps/ui/dist/fancybox/fancybox.css';

// 生成静态路径
export async function getStaticPaths() {
	const albums = await scanAlbums();
	return albums.map((album) => ({
		params: { id: album.id },
		props: { album },
	}));
}

const { album } = Astro.props;

if (!album) {
	return Astro.redirect('/404/');
}

const title = `${album.title} | 相册 | ${SITE_TITLE}`;
const description = album.description || `${album.title} - 包含 ${album.photos.length} 张照片`;
---

<MainLayout title={title} description={description}>
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
		<!-- 返回按钮 -->
		<div class="mb-6">
			<a 
				href="/albums/" 
				class="inline-flex items-center gap-2 text-zinc-500 dark:text-zinc-400 hover:text-purple-500 dark:hover:text-purple-400 transition-colors"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6"/>
				</svg>
				返回相册列表
			</a>
		</div>

		<!-- 相册标题信息 -->
		<header class="mb-8">
			<h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mb-4">
				{album.title}
			</h1>
			
			{album.description && (
				<p class="text-zinc-600 dark:text-zinc-400 text-lg mb-4">
					{album.description}
				</p>
			)}
			
			<!-- 相册元数据 -->
			<div class="flex flex-wrap items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400">
				<span class="flex items-center gap-1">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
						<circle cx="9" cy="9" r="2"/>
						<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
					</svg>
					{album.photos.length} 张照片
				</span>
				<time>{new Date(album.date).toLocaleDateString('zh-CN')}</time>
				{album.location && (
					<span class="flex items-center gap-1">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
							<circle cx="12" cy="10" r="3"/>
						</svg>
						{album.location}
					</span>
				)}
			</div>
			
			<!-- 标签 -->
			{album.tags && album.tags.length > 0 && (
				<div class="flex flex-wrap gap-2 mt-4">
					{album.tags.map((tag: string) => (
						<span class="px-3 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 text-sm rounded-full">
							{tag}
						</span>
					))}
				</div>
			)}
		</header>

		<!-- 照片网格 -->
		<div 
			class={`photo-gallery ${album.layout === 'masonry' ? 'masonry-layout' : 'grid-layout'}`}
			data-layout={album.layout || 'grid'}
			data-columns={album.columns || 3}
		>
			{album.photos.map((photo: Photo, index: number) => (
				<figure class="photo-item group relative overflow-hidden rounded-xl cursor-pointer" data-fancybox="gallery" data-src={photo.src}>
					<img 
						src={photo.src}
						alt={photo.alt || photo.title || `Photo ${index + 1}`}
						class="photo-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
						loading="lazy"
					/>
					<!-- 悬停遮罩 -->
					<div class="photo-overlay absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
						<div class="p-4 text-white transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
							{photo.title && <p class="font-medium">{photo.title}</p>}
							{photo.description && <p class="text-sm text-white/80 mt-1">{photo.description}</p>}
						</div>
					</div>
				</figure>
			))}
		</div>

		<!-- 空状态 -->
		{album.photos.length === 0 && (
			<div class="text-center py-20">
				<div class="w-24 h-24 mx-auto mb-6 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-zinc-400">
						<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
						<circle cx="9" cy="9" r="2"/>
						<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
					</svg>
				</div>
				<h3 class="text-xl font-medium text-zinc-900 dark:text-white mb-2">
					暂无照片
				</h3>
				<p class="text-zinc-500 dark:text-zinc-400">
					该相册还没有添加照片
				</p>
			</div>
		)}
	</div>
</MainLayout>

<script>
	// 初始化 Fancybox
	import { Fancybox } from "@fancyapps/ui";

	function initFancybox() {
		Fancybox.bind('[data-fancybox="gallery"]', {
			Carousel: {
				infinite: false,
			},
			Thumbs: {
				autoStart: true,
			},
			Toolbar: {
				display: {
					left: ["infobar"],
					middle: [
						"zoomIn",
						"zoomOut",
						"toggle1to1",
						"rotateCCW",
						"rotateCW",
						"flipX",
						"flipY",
					],
					right: ["slideshow", "thumbs", "close"],
				},
			},
		});
	}

	// 页面加载完成后初始化
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFancybox);
	} else {
		initFancybox();
	}

	// 监听 Astro 页面切换
	document.addEventListener('astro:page-load', initFancybox);
</script>

<style>
	/* 网格布局 */
	.grid-layout {
		display: grid;
		gap: 1rem;
	}

	.grid-layout[data-columns="2"] {
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
	}

	.grid-layout[data-columns="3"] {
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
	}

	.grid-layout[data-columns="4"] {
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
	}

	/* 瀑布流布局 */
	.masonry-layout {
		columns: 2;
		column-gap: 1rem;
	}

	@media (min-width: 768px) {
		.masonry-layout {
			columns: 3;
		}
	}

	@media (min-width: 1280px) {
		.masonry-layout[data-columns="4"] {
			columns: 4;
		}
	}

	.masonry-layout .photo-item {
		break-inside: avoid;
		margin-bottom: 1rem;
	}

	/* 照片项样式 */
	.photo-item {
		position: relative;
		overflow: hidden;
		border-radius: 0.75rem;
		background: #f3f4f6;
	}

	.dark .photo-item {
		background: #27272a;
	}

	.grid-layout .photo-item {
		aspect-ratio: 1;
	}

	.masonry-layout .photo-item {
		width: 100%;
	}

	.photo-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.masonry-layout .photo-image {
		height: auto;
	}

	/* 悬停遮罩 */
	.photo-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.2), transparent);
		opacity: 0;
		transition: opacity 0.3s ease;
		display: flex;
		align-items: flex-end;
		padding: 1rem;
	}

	.photo-item:hover .photo-overlay {
		opacity: 1;
	}

	.photo-overlay > div {
		transform: translateY(1rem);
		transition: transform 0.3s ease;
	}

	.photo-item:hover .photo-overlay > div {
		transform: translateY(0);
	}

	/* 响应式调整 */
	@media (max-width: 640px) {
		.grid-layout {
			grid-template-columns: repeat(2, 1fr) !important;
		}

		.masonry-layout {
			columns: 2;
		}
	}

	@media (max-width: 480px) {
		.grid-layout {
			grid-template-columns: 1fr !important;
		}

		.masonry-layout {
			columns: 1;
		}
	}
</style>
