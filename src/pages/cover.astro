---
import MainLayout from '../layouts/MainLayout.astro';
import CoverGenerator from '../components/CoverGenerator.svelte';
import { SITE_TITLE } from '../consts';

const title = `封面生成 | ${SITE_TITLE}`;
const description = '生成精美的封面图片';
---

<MainLayout title={title} description={description}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
        <div class="card-surface p-6 md:p-8">
            <div class="flex items-center gap-3 mb-6">
                <div class="h-8 w-8 rounded-lg bg-blue-600 flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                </div>
                <h1 class="text-2xl font-bold">封面生成</h1>
            </div>
            <CoverGenerator client:only="svelte" />
        </div>
    </div>
</MainLayout>
