---
/**
 * Badge - 徽章组件
 * 
 * 功能：
 * 1. 支持带链接的徽章
 * 2. 支持自定义图标
 * 3. 支持圆形和方形样式
 * 4. 自动根据域名获取站点图标
 * 5. GitHub 链接自动获取头像
 */

interface Props {
  img?: string;
  text?: string;
  link?: string;
  round?: boolean;
  square?: boolean;
}

const { img: customImg, text, link, round: roundProp, square: squareProp } = Astro.props;

// 判断是否为外部链接
function isExtLink(url: string): boolean {
  if (!url) return false;
  return url.startsWith('http://') || url.startsWith('https://');
}

// 从 URL 中提取完整域名
function getDomain(url: string): string {
  if (!url) return '';
  
  try {
    if (!url.startsWith('http://') && !url.startsWith('https://')) {
      return url;
    }
    
    const urlObj = new URL(url);
    return urlObj.hostname;
  } catch {
    return url;
  }
}

// 获取 GitHub 用户名
function getGithubUsername(url: string): string | undefined {
  if (!url) return undefined;
  
  try {
    const urlObj = new URL(url);
    if (urlObj.hostname === 'github.com') {
      const parts = urlObj.pathname.split('/').filter(Boolean);
      if (parts.length > 0) {
        return parts[0];
      }
    }
  } catch {
    return undefined;
  }
  
  return undefined;
}

// 获取 GitHub 头像
function getGithubAvatar(username: string): string {
  return `https://github.com/${username}.png`;
}

// 获取站点 favicon
function getFavicon(domain: string): string {
  return `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
}

// 计算图标
const img = customImg || (() => {
  if (link) {
    const ghUsername = getGithubUsername(link);
    if (ghUsername) {
      return getGithubAvatar(ghUsername);
    }
    if (isExtLink(link)) {
      return getFavicon(getDomain(link));
    }
  }
  return '';
})();

// 计算圆形样式：有图时默认圆形，除非指定方形；无图时默认方形，除非指定圆形
const isRound = img ? !squareProp : (roundProp ?? false);

// 计算提示文本
const tip = link ? (isExtLink(link) ? getDomain(link) : decodeURIComponent(link)) : '';
---

<a
  href={link}
  class="badge"
  class:round={isRound}
  title={tip || undefined}
  {...(link && isExtLink(link) ? { target: '_blank', rel: 'noopener noreferrer nofollow' } : {})}
>
  {img && (
    <img
      src={img}
      alt=""
      class="badge-icon"
      width="24"
      height="24"
      loading="lazy"
    />
  )}
  <span class="badge-text">
    <slot />{text}
  </span>
</a>

<style>
  /* 对齐到基线，同时保持图片垂直居中 */
  .badge {
    display: inline-flex;
    align-items: baseline;
    margin: 0 0.1em;
    border-radius: 9999px;
    font-size: inherit;
    transition: all 0.2s;
    text-decoration: none;
    color: currentColor;
    gap: 0.2em;
    vertical-align: baseline;
  }

  .badge[href]:hover {
    opacity: 0.8;
  }

  .badge-icon {
    align-self: baseline;
    height: 0.85em;
    width: 0.85em;
    border-radius: 9999px;
    object-fit: cover;
    flex-shrink: 0;
    margin-top: 0.05em;
  }

  .badge-text {
    line-height: inherit;
  }

  .badge-text:empty {
    display: none;
  }

  /* 暗色模式适配 */
  :global(.dark) .badge {
    opacity: 0.9;
  }

  :global(.dark) .badge[href]:hover {
    opacity: 1;
  }
</style>
