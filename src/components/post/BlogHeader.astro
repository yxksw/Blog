---
/**
 * BlogHeader - 博客头部组件
 * 
 * 功能：
 * 1. 显示博客标题和副标题
 * 2. 支持自定义 Logo
 * 3. 鼠标悬浮时显示 Emoji 动画效果
 * 4. 标题文字动态效果
 */

interface Props {
  tag?: string;
  title?: string;
  subtitle?: string;
  logo?: string;
  emojiTail?: string[];
  showTitle?: boolean;
}

const {
  tag = 'div',
  title = '纸鹿摸鱼处',
  subtitle = '纸鹿至麓不知路，支炉制露不止漉',
  logo = 'https://api.iconify.design/noto:deer.svg',
  emojiTail = ['📄', '🦌', '🫣', '🐟', ''],
  showTitle = true,
} = Astro.props;

// 生成固定的延迟时间
const getFixedDelay = (index: number) => {
  return `--delay: ${index}s`;
};
---

<a href="/" class="blog-header">
  {emojiTail && (
    <div class="emoji-tail">
      {emojiTail.map((emoji, emojiIndex) => (
        <span
          class="split-char"
          style={getFixedDelay(emojiIndex * 0.6 - 3)}
        >
          {emoji}
        </span>
      ))}
    </div>
  )}

  <img
    src={logo}
    alt={title}
    class="blog-logo"
    class:circle={showTitle}
    width="48"
    height="48"
    loading="lazy"
  />

  {showTitle && (
    <div class="blog-text">
      {tag === 'div' ? (
        <div class="header-title">
          {title.split('').map((char, charIndex) => (
            <span
              class="split-char"
              style={getFixedDelay((charIndex + 1) * 0.1)}
            >
              {char}
            </span>
          ))}
        </div>
      ) : (
        <h1 class="header-title">
          {title.split('').map((char, charIndex) => (
            <span
              class="split-char"
              style={getFixedDelay((charIndex + 1) * 0.1)}
            >
              {char}
            </span>
          ))}
        </h1>
      )}

      <div class="header-subtitle">
        {subtitle}
      </div>
    </div>
  )}
</a>

<style>
  .blog-header {
    contain: layout;
    display: flex;
    align-items: center;
    gap: 0.5em;
    position: relative;
    margin: clamp(1rem, 2rem, 5vh) 1rem min(1rem, 5vh);
    line-height: 1.4;
    color: var(--c-text, #18181b);
    user-select: none;
    text-decoration: none;
  }

  .blog-logo {
    height: 3em;
    width: auto;
    object-fit: cover;
  }

  .blog-logo.circle {
    width: 3em;
    border-radius: 50%;
    box-shadow: 
      0 1px 2px rgba(0, 0, 0, 0.05),
      0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .header-title {
    font-family: "AlimamaFangYuanTi", "Noto Sans SC", sans-serif;
    font-size: 1.5em;
    font-synthesis: none;
    font-variation-settings: "wght" 600, "BEVL" 100;
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .header-title > .split-char {
    animation: 3.14s infinite alternate vf-weight, 2.72s infinite alternate vf-bevel;
    animation-delay: var(--delay);
    animation-play-state: paused;
    display: inline-block;
  }

  .header-subtitle {
    opacity: 0.5;
    font-size: 0.8em;
    margin-top: 0.1em;
  }

  @keyframes vf-weight {
    0% { font-weight: 600; }
    38.2% { font-weight: 300; }
    100% { font-weight: 900; }
  }

  @keyframes vf-bevel {
    from { font-variation-settings: "BEVL" 100; }
    to { font-variation-settings: "BEVL" 1; }
  }

  .emoji-tail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    align-content: center;
    justify-items: center;
    position: absolute;
    opacity: 0.2;
    inset: 0;
    font-size: 4rem;
    transition: opacity 1s;
    filter: blur(2px);
    pointer-events: none;
    z-index: -2;
    width: 100%;
    height: 100%;
  }

  .emoji-tail > .split-char {
    animation: 5s infinite alternate emoji-floating;
    animation-delay: var(--delay);
    animation-play-state: paused;
  }

  .blog-header:hover {
    .emoji-tail {
      opacity: 0.5;
    }

    .split-char {
      animation-play-state: running;
    }
  }

  @keyframes emoji-floating {
    50% {
      transform: translate(-12px, -4px) scale(1.2);
      filter: blur(4px);
    }

    100% {
      transform: translate(-4px, -12px) scale(0.9);
      filter: blur(1px);
    }
  }

  /* 暗色模式适配 */
  :global(.dark) .blog-header {
    color: var(--c-text, #f4f4f5);
  }

  :global(.dark) .blog-logo.circle {
    box-shadow: 
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 4px 8px rgba(0, 0, 0, 0.4);
  }
</style>
