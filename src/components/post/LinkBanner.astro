---
/**
 * LinkBanner - 链接横幅组件
 * 
 * 功能：
 * 1. 显示带背景图的链接卡片
 * 2. 支持自定义标题和描述
 * 3. 无描述时自动显示域名
 * 4. 悬停效果
 */

interface Props {
  banner?: string;
  title: string;
  description?: string;
  link: string;
}

const { banner, title, description, link } = Astro.props;

// 提取域名
function getDomain(url: string): string {
  try {
    const urlObj = new URL(url);
    return urlObj.hostname;
  } catch {
    return url;
  }
}

const displayDesc = description || getDomain(link);
---

<a href={link} target="_blank" rel="noopener noreferrer" class="link-banner" title={`${title} - ${displayDesc}`}>
  {banner && (
    <div class="link-banner-image-wrapper">
      <img class="link-banner-bg" src={banner} alt={title} loading="lazy" />
    </div>
  )}
  <div class="link-banner-info">
    <div class="link-banner-title">{title}</div>
    <div class="link-banner-desc">{displayDesc}</div>
  </div>
</a>

<style>
  .link-banner {
    display: block;
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: var(--c-bg-soft, rgba(0, 0, 0, 0.05));
    border: 1px solid var(--c-border, rgba(0, 0, 0, 0.1));
    text-decoration: none;
    transition: all 0.2s ease;
    line-height: 1.4;
    max-width: 600px;
    margin: 1.5rem auto;
  }

  .link-banner:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-color: var(--c-primary, #3b82f6);
  }

  .link-banner-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 2.4;
    overflow: hidden;
  }

  .link-banner-image-wrapper::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--c-bg, rgb(255, 255, 255)));
    pointer-events: none;
  }

  .link-banner-bg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .link-banner-info {
    padding: 0.75rem 1rem 1rem;
  }

  .link-banner-title {
    font-size: 1.1em;
    font-weight: 600;
    color: var(--c-text, inherit);
  }

  .link-banner-desc {
    margin-top: 0.4em;
    font-size: 0.85em;
    color: var(--c-text-2, rgba(0, 0, 0, 0.6));
    opacity: 0.8;
  }

  /* 暗色模式适配 */
  :global(.dark) .link-banner {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .link-banner:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  :global(.dark) .link-banner-desc {
    color: rgba(255, 255, 255, 0.6);
  }
</style>
