---
interface Props {
	postSlug: string;
}

const { postSlug } = Astro.props;
---

<section class="comments-section mt-12 border-t border-zinc-200 pt-8 dark:border-zinc-700">
	<h2 class="mb-6 text-2xl font-semibold text-zinc-900 dark:text-zinc-100">评论区</h2>

	<div id="comment-form-container" class="mt-8">
		<!-- Show login prompt when not logged in -->
		<div id="login-prompt" class="hidden">
			<p class="text-zinc-600 dark:text-zinc-400">
				<a href="https://api.261770.xyz/api/auth/github/start" class="text-blue-600 hover:underline dark:text-blue-400">
					在Github登录
				</a>
				来评论
			</p>
		</div>

		<!-- Comment form - visible when logged in -->
		<form id="comment-form" class="hidden space-y-4">
			<textarea
				id="comment-content"
				name="content"
				rows="4"
				required
				placeholder="Write a comment... (Markdown supported)"
				class="w-full rounded-lg border border-zinc-200 bg-zinc-50 p-3 text-zinc-900 placeholder-zinc-400 focus:border-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-400 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:placeholder-zinc-500"
			></textarea>
			<p class="text-xs text-zinc-500 dark:text-zinc-400">
				支持: Markdown格式 (<a href="https://markdown.com.cn/basic-syntax/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline dark:text-blue-400">Markdown格式参考点此</a>)
			</p>
			<div class="flex items-center justify-between">
				<button
					type="submit"
					class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200"
				>
					提交评论
				</button>
				<button
					type="button"
					id="cancel-reply-btn"
					class="hidden rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-50 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700"
				>
					取消回复
				</button>
			</div>
			<input type="hidden" id="parent-comment-id" value="" />
		</form>
	</div>

	<!-- Comments list -->
	<div id="comments-container" class="mt-8 space-y-6" data-comments-container data-post-slug={postSlug}></div>
</section>

<script is:inline>
	// Use shared auth functions from auth.js
	const { storeTokenFromHash, getAuthToken, getCurrentUser } = window.__auth || {};

	let currentReplyTo = null;

	// Simple Markdown parser (lightweight, no external dependencies)
	const parseMarkdown = (text) => {
		if (!text) return '';
		
		let html = text
			// Escape HTML first
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			// Bold: **text** or __text__
			.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
			.replace(/__(.+?)__/g, '<strong>$1</strong>')
			// Italic: *text* or _text_
			.replace(/\*(.+?)\*/g, '<em>$1</em>')
			.replace(/_(.+?)_/g, '<em>$1</em>')
			// Inline code: `code`
			.replace(/`([^`]+)`/g, '<code class="rounded bg-zinc-200 px-1 py-0.5 text-sm font-mono dark:bg-zinc-700">$1</code>')
			// Links: [text](url)
			.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline dark:text-blue-400">$1</a>')
			// Strikethrough: ~~text~~
			.replace(/~~(.+?)~~/g, '<del>$1</del>')
			// Unordered lists: - item or * item
			.replace(/(?:^|\n)([-*]) (.+)/g, (match, bullet, content) => {
				return `<li class="ml-4">${content}</li>`;
			})
			// Line breaks
			.replace(/\n/g, '<br>');
		
		return html;
	};

	// Format relative time
	const formatRelativeTime = (dateString) => {
		const date = new Date(dateString);
		const now = new Date();
		const diff = now - date;
		const seconds = Math.floor(diff / 1000);
		const minutes = Math.floor(seconds / 60);
		const hours = Math.floor(minutes / 60);
		const days = Math.floor(hours / 24);

		if (days > 7) {
			return date.toLocaleDateString();
		} else if (days > 0) {
			return `${days} day${days > 1 ? 's' : ''} ago`;
		} else if (hours > 0) {
			return `${hours} hour${hours > 1 ? 's' : ''} ago`;
		} else if (minutes > 0) {
			return `${minutes} minute${minutes > 1 ? 's' : ''} ago`;
		} else {
			return 'Just now';
		}
	};

	// Render a single comment
	const renderComment = (comment, isReply = false) => {
		const replyClass = isReply ? 'ml-12 border-l-2 border-zinc-200 pl-4 dark:border-zinc-700' : '';
		const repliesHtml = comment.replies && comment.replies.length > 0
			? `<div class="mt-4 space-y-4">${comment.replies.map(reply => renderComment(reply, true)).join('')}</div>`
			: '';

		const contentHtml = parseMarkdown(comment.content);

		return `
			<div class="comment-item ${replyClass}" data-comment-id="${comment.id}">
				<div class="flex gap-4 rounded-lg border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-700 dark:bg-zinc-800/50">
					<img
						src="${comment.author?.avatar || 'https://cdn.jsdmirror.com/gh/zsxcoder/github-img@main/img/yxk-avatar.avifp'}"
						alt="${comment.author?.username || 'User'} avatar"
						class="h-10 w-10 shrink-0 rounded-full border border-zinc-200 object-cover dark:border-zinc-700"
					/>
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2">
							<span class="font-medium text-zinc-900 dark:text-zinc-100">${comment.author?.username || 'Anonymous'}</span>
							<span class="text-sm text-zinc-500 dark:text-zinc-400">${formatRelativeTime(comment.createdAt || comment.created_at)}</span>
							${comment.parentId ? '<span class="text-xs text-zinc-400 dark:text-zinc-500">(reply)</span>' : ''}
						</div>
						<div class="comment-content mt-1 text-zinc-700 dark:text-zinc-300">${contentHtml}</div>
						<div class="mt-2 flex items-center gap-3">
							<button 
								onclick="startReply('${comment.id}', '${comment.author?.username || 'Anonymous'}')"
								class="text-sm text-zinc-500 transition-colors hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200"
							>
								Reply
							</button>
						</div>
					</div>
				</div>
				${repliesHtml}
			</div>
		`;
	};

	// Render comments
	const renderComments = (comments) => {
		const container = document.getElementById('comments-container');
		if (!container) return;

		if (!comments || comments.length === 0) {
			container.innerHTML = '<p class="text-zinc-500 dark:text-zinc-400">暂无评论。成为第一个评论者吧！</p>';
			return;
		}

		container.innerHTML = comments.map(comment => renderComment(comment)).join('');
	};

	// Start replying to a comment
	window.startReply = (commentId, username) => {
		currentReplyTo = commentId;
		const parentIdInput = document.getElementById('parent-comment-id');
		const cancelBtn = document.getElementById('cancel-reply-btn');
		const textarea = document.getElementById('comment-content');

		if (parentIdInput) parentIdInput.value = commentId;
		if (cancelBtn) cancelBtn.classList.remove('hidden');
		if (textarea) {
			textarea.placeholder = `Reply to ${username}...`;
			textarea.focus();
		}

		// Scroll to form
		const form = document.getElementById('comment-form');
		if (form) {
			form.scrollIntoView({ behavior: 'smooth', block: 'center' });
		}
	};

	// Cancel reply
	const cancelReply = () => {
		currentReplyTo = null;
		const parentIdInput = document.getElementById('parent-comment-id');
		const cancelBtn = document.getElementById('cancel-reply-btn');
		const textarea = document.getElementById('comment-content');

		if (parentIdInput) parentIdInput.value = '';
		if (cancelBtn) cancelBtn.classList.add('hidden');
		if (textarea) {
			textarea.placeholder = 'Write a comment... (Markdown supported)';
			textarea.value = '';
		}
	};

	// Load comments
	async function loadComments(postSlug) {
		const container = document.getElementById('comments-container');
		if (!container) {
			console.log('Comments container not found');
			return;
		}

		console.log('Loading comments for:', postSlug);

		try {
			const response = await fetch(`https://api.261770.xyz/api/comments?post_id=${encodeURIComponent(postSlug)}`);
			if (response.ok) {
				const data = await response.json();
				const comments = data?.comments ?? data ?? [];
				renderComments(comments);
			} else {
				renderComments([]);
			}
		} catch (error) {
			console.error('Failed to load comments:', error);
			renderComments([]);
		}
	}

	// Submit comment
	async function submitComment(postSlug, content, parentId = null) {
		const token = getAuthToken();
		if (!token) return false;

		const payload = {
			post_id: postSlug,
			content: content,
		};

		if (parentId) {
			payload.parent_id = parentId;
		}

		const response = await fetch(`${window.__API_BASE}/api/comments`, {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
				Authorization: `Bearer ${token}`,
			},
			body: JSON.stringify(payload),
		});

		return response.ok;
	}

	// Initialize comments
	const initComments = async () => {
		const container = document.getElementById('comments-container');
		if (!container) return;

		const postSlug = container.dataset.postSlug;
		if (!postSlug) return;

		storeTokenFromHash();

		const user = await getCurrentUser();
		const loginPrompt = document.getElementById('login-prompt');
		const commentForm = document.getElementById('comment-form');

		// Show comment form if logged in, otherwise show login prompt
		if (user) {
			if (loginPrompt) loginPrompt.classList.add('hidden');
			if (commentForm) commentForm.classList.remove('hidden');
		} else {
			if (loginPrompt) loginPrompt.classList.remove('hidden');
			if (commentForm) commentForm.classList.add('hidden');
		}

		// Load comments
		loadComments(postSlug);

		// Bind cancel reply button
		const cancelBtn = document.getElementById('cancel-reply-btn');
		if (cancelBtn && !cancelBtn.dataset.bound) {
			cancelBtn.dataset.bound = 'true';
			cancelBtn.addEventListener('click', cancelReply);
		}

		// Bind form submit
		const form = document.getElementById('comment-form');
		if (form && !form.dataset.bound) {
			form.dataset.bound = 'true';
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const textarea = document.getElementById('comment-content');
				const parentIdInput = document.getElementById('parent-comment-id');
				const content = textarea?.value?.trim();
				if (!content) return;

				const parentId = parentIdInput?.value || null;

				const button = form.querySelector('button[type="submit"]');
				if (button) {
					button.disabled = true;
					button.textContent = parentId ? 'Submitting Reply...' : 'Submitting Comment...';
				}

				const success = await submitComment(postSlug, content, parentId);

				if (success) {
					textarea.value = '';
					cancelReply();
					loadComments(postSlug);
					// Show success message
					const successMsg = document.createElement('div');
					successMsg.className = 'mt-2 rounded-lg bg-green-100 p-2 text-sm text-green-700 dark:bg-green-900/30 dark:text-green-300';
					successMsg.textContent = parentId ? 'Reply submitted and pending approval!' : 'Comment submitted and pending approval!';
					form.appendChild(successMsg);
					setTimeout(() => successMsg.remove(), 3000);
				} else {
					alert('Failed to submit comment. Please try again.');
				}

				if (button) {
					button.disabled = false;
					button.textContent = 'Submit Comment';
				}
			});
		}
	};

	initComments();
	document.addEventListener('astro:page-load', initComments);
	document.addEventListener('astro:after-swap', initComments);
</script>

<style>
	/* Comment content styles */
	.comment-content :is(strong, b) {
		font-weight: 600;
	}
	.comment-content :is(em, i) {
		font-style: italic;
	}
	.comment-content code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}
	.comment-content a {
		word-break: break-all;
	}
	.comment-content del {
		text-decoration: line-through;
		opacity: 0.7;
	}
	.comment-content li {
		margin-top: 0.25rem;
	}
</style>
