---
import type { TimetableViewModel } from "../../types/timetable";
import LiveTimetableStatus from "./LiveTimetableStatus.astro";
import TimetableDayList from "./TimetableDayList.astro";
import TimetableGrid from "./TimetableGrid.astro";
import TimetableVisualEditor from "./TimetableVisualEditor.svelte";

interface Props {
	viewModel: TimetableViewModel;
	isCurrentWeek?: boolean;
	baselineText: string;
}

const { viewModel, isCurrentWeek = false, baselineText } = Astro.props;

const liveStatusPayload = {
	coursesByDay: viewModel.coursesByDay,
};

const BASE = import.meta.env.BASE_URL;
---

<div class="card-surface p-6 md:p-8">
	<div class="flex items-center justify-between gap-3 flex-wrap mb-6">
		<div class="flex items-center gap-2">
			<div class="h-8 w-8 rounded-lg bg-blue-600 flex items-center justify-center text-white">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
			</div>
			<h1 class="text-2xl font-bold">{viewModel.tableName}</h1>
			<div class="text-sm font-medium opacity-80">共 {viewModel.maxWeek} 周</div>
		</div>
	</div>

	<div class="flex flex-wrap items-center gap-3 mb-5 text-sm">
		<div class="inline-flex items-center gap-1">
			<a
				href={`${BASE}timetable/${Math.max(1, viewModel.currentWeek - 1)}/`}
				class:list={[
					"inline-flex items-center justify-center h-9 w-9 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-700",
					{ "pointer-events-none opacity-50": viewModel.currentWeek <= 1 },
				]}
				aria-label="上一周"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180"><path d="m9 18 6-6-6-6"/></svg>
			</a>
			<span class="min-w-[4.5rem] px-1 text-center font-medium">第 {viewModel.currentWeek} 周</span>
			<a
				href={`${BASE}timetable/${Math.min(viewModel.maxWeek, viewModel.currentWeek + 1)}/`}
				class:list={[
					"inline-flex items-center justify-center h-9 w-9 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-700",
					{ "pointer-events-none opacity-50": viewModel.currentWeek >= viewModel.maxWeek },
				]}
				aria-label="下一周"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
			</a>
			{isCurrentWeek && <span class="rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-2.5 py-1 text-sm font-medium text-emerald-600 dark:text-emerald-400 leading-none">当前周</span>}
		</div>
	</div>

	<LiveTimetableStatus payload={liveStatusPayload} class="mb-4" />

	<TimetableVisualEditor client:load viewModel={viewModel} baselineText={baselineText} />

	<p class="text-xs opacity-70 mb-4">提示：周次切换后将展示该周实际有课的安排，多周课程会在对应周自动出现。</p>

	<TimetableGrid viewModel={viewModel} />
	<TimetableDayList viewModel={viewModel} />
</div>
