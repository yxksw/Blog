---
// 新文章通知组件 - 基于 fuwari 实现重构
// 功能：RSS 存储到 IndexedDB，差异比较，通知面板
---

<style>
    #notification-panel {
        position: relative;
        width: 3.75rem;
        height: 3.75rem;
        border-radius: 50%;
        overflow: hidden;
        box-sizing: border-box;
        transition:
            width 360ms cubic-bezier(0.4, 0, 0.2, 1),
            height 360ms cubic-bezier(0.4, 0, 0.2, 1),
            border-radius 360ms cubic-bezier(0.4, 0, 0.2, 1),
            transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1),
            opacity 260ms ease;
    }
    #notification-panel.is-open {
        width: var(--np-open-width, min(20rem, calc(100vw - 2rem)));
        height: var(--np-open-height, auto);
        min-height: auto;
        max-height: min(40vh, 18rem);
        border-radius: 1rem;
    }
    #notification-minimized {
        position: absolute;
        inset: 0;
        transition: opacity 160ms ease, transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    #notification-content {
        position: absolute;
        inset: 0;
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
        transition: opacity 200ms ease, transform 260ms ease;
    }
    #notification-panel.is-open #notification-minimized {
        opacity: 0;
        pointer-events: none;
        transform: none;
    }
    #notification-panel.is-open-content #notification-content {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }
</style>

<div id="new-post-notification" class="fixed bottom-28 right-4 z-50 pointer-events-none">
    <div id="notification-panel" class="pointer-events-auto bg-white dark:bg-zinc-800 border-2 border-blue-500 dark:border-blue-400 text-blue-500 dark:text-blue-400 shadow-lg transform translate-y-20 opacity-0">
        <button id="notification-minimized" aria-label="New post notification" class="flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </button>

        <div id="notification-content" class="flex flex-col p-4">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2 text-blue-500 dark:text-blue-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                    <h3 class="font-bold text-zinc-900 dark:text-white text-sm">发现新文章</h3>
                </div>
                <div class="flex items-center gap-1">
                    <button id="clear-notification" class="text-zinc-500 dark:text-zinc-400 hover:text-red-500 transition-colors p-1 rounded-md hover:bg-red-500/10" title="清空通知">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                    </button>
                    <button id="minimize-notification" class="text-zinc-500 dark:text-zinc-400 hover:text-blue-500 transition-colors p-1 rounded-md hover:bg-blue-500/10" title="隐藏">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                    </button>
                </div>
            </div>
            <div id="new-post-list" class="text-sm text-zinc-700 dark:text-zinc-300 transition-colors space-y-1 flex-1 overflow-y-auto overflow-x-hidden"></div>
        </div>
    </div>
    <span id="notification-dot" class="absolute top-0 right-0 w-3 h-3 bg-red-500 rounded-full border-2 border-white dark:border-zinc-800 animate-pulse pointer-events-none transform translate-y-20 opacity-0 scale-0 transition-all duration-260 ease-out"></span>
</div>

<script>
    import * as Diff from 'diff';

    interface Post {
        title: string;
        link: string;
        guid: string;
        pubDate: number;
        description: string;
        content: string;
        isUpdated?: boolean;
        diff?: Diff.Change[] | null;
        diffType?: string;
    }

    interface NotificationState {
        timestamp: number;
        items: Post[];
    }

    (async function() {
    const __diffLogEnabled = (() => {
        try {
            const sp = new URLSearchParams(window.location.search);
            return sp.get('__diff_log') === '1';
        } catch {
            return false;
        }
    })();
    const BASE_URL = import.meta.env.BASE_URL || '/';
    const basePath = String(BASE_URL).endsWith('/') ? String(BASE_URL).slice(0, -1) : String(BASE_URL);
    const withBasePath = (pathname: string): string => {
        const p = String(pathname || '');
        if (!basePath || basePath === '/' || !p.startsWith('/')) return p;
        if (p === basePath || p.startsWith(`${basePath}/`)) return p;
        return `${basePath}${p}`;
    };

    const sp = new URLSearchParams(window.location.search);
    if (sp.get('__diff_debug_cleanup') === '1') {
        try {
            const DB_NAME = 'new-posts-db';
            indexedDB.deleteDatabase(DB_NAME);
            localStorage.removeItem('new-posts-notification-state');
            localStorage.removeItem('new-posts-cache');
            localStorage.removeItem('new-posts-init-time');
            const url = new URL(window.location.href);
            url.searchParams.delete('__diff_debug_cleanup');
            window.history.replaceState({}, '', url.toString());
        } catch {}
    }
    if (sp.get('__diff_debug') === '1') return;

    const DB_NAME = 'new-posts-db';
    const DB_VERSION = 1;
    const STORE_OLD = 'posts-old';
    const STORE_NEW = 'posts-new';
    const LOCAL_STORAGE_KEY = 'new-posts-cache';
    const NOTIFICATION_STATE_KEY = 'new-posts-notification-state';
    const INIT_TIME_KEY = 'new-posts-init-time';

    function openDB(): Promise<IDBDatabase> {
        return new Promise((resolve, reject) => {
            const request = indexedDB.open(DB_NAME, DB_VERSION);
            request.onerror = () => reject(request.error);
            request.onsuccess = () => resolve(request.result as IDBDatabase);
            request.onupgradeneeded = (event: IDBVersionChangeEvent) => {
                const target = event.target as IDBOpenDBRequest;
                const db = target.result;
                if (!db.objectStoreNames.contains(STORE_OLD)) {
                    db.createObjectStore(STORE_OLD, { keyPath: 'id' });
                }
                if (!db.objectStoreNames.contains(STORE_NEW)) {
                    db.createObjectStore(STORE_NEW, { keyPath: 'id' });
                }
            };
        });
    }

    function getStoredPosts(db: IDBDatabase, storeName: string): Promise<Post[]> {
        return new Promise((resolve, reject) => {
            const transaction = db.transaction([storeName], 'readonly');
            const store = transaction.objectStore(storeName);
            const request = store.getAll();
            request.onsuccess = () => resolve((request.result as Post[]) || []);
            request.onerror = () => reject(request.error);
        });
    }

    function savePosts(db: IDBDatabase, storeName: string, posts: Post[]): Promise<void> {
        return new Promise((resolve, reject) => {
            const transaction = db.transaction([storeName], 'readwrite');
            const store = transaction.objectStore(storeName);
            const clearRequest = store.clear();
            clearRequest.onsuccess = () => {
                let completed = 0;
                if (posts.length === 0) {
                    resolve();
                    return;
                }
                posts.forEach(post => {
                    const addRequest = store.add({ ...post, id: generateId(post.guid) });
                    addRequest.onsuccess = () => {
                        completed++;
                        if (completed === posts.length) resolve();
                    };
                    addRequest.onerror = () => reject(addRequest.error);
                });
            };
            clearRequest.onerror = () => reject(clearRequest.error);
        });
    }

    function clearStore(db: IDBDatabase, storeName: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const transaction = db.transaction([storeName], 'readwrite');
            const store = transaction.objectStore(storeName);
            const request = store.clear();
            request.onsuccess = () => resolve();
            request.onerror = () => reject(request.error);
        });
    }

    function generateId(guid: string): string {
        let hash = 0;
        const str = String(guid || '');
        for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash;
        }
        return 'id_' + Math.abs(hash).toString(36);
    }

    function normalizeGuid(guid: string, link: string): string {
        const g = String(guid || link || '').trim();
        try {
            const url = new URL(g);
            return url.pathname + url.search;
        } catch {
            return g;
        }
    }

    async function fetchRSS(): Promise<Post[]> {
        try {
            const possiblePaths = [
                withBasePath('/rss.xml'),
                '/rss.xml',
                './rss.xml',
                'rss.xml'
            ];
            
            let response: Response | null = null;
            
            for (const rssPath of possiblePaths) {
                try {
                    response = await fetch(rssPath, { cache: 'no-store' });
                    if (response.ok) {
                        break;
                    }
                } catch (e) {
                    // 静默处理 fetch 错误
                }
            }
            
            if (!response || !response.ok) {
                return [];
            }
            
            const text = await response.text();
            const parser = new DOMParser();
            const xml = parser.parseFromString(text, 'text/xml');
            
            const channelLink = xml.querySelector("channel > link")?.textContent?.trim();
            let prodOrigin = "";
            if (channelLink) {
                try {
                    prodOrigin = new URL(channelLink).origin;
                } catch {}
            }
            const currentOrigin = window.location.origin;
            
            const items = Array.from(xml.querySelectorAll('item'));
            
            return items.map((item: Element): Post => {
                const title = item.querySelector('title')?.textContent || '';
                let link = (item.querySelector('link')?.textContent || '').trim();
                let rawGuid = (item.querySelector('guid')?.textContent || '').trim();
                const pubDate = new Date(item.querySelector('pubDate')?.textContent || '').getTime();
                let description = item.querySelector('description')?.textContent || '';
                
                const contentEncoded = item.getElementsByTagNameNS('http://purl.org/rss/1.0/modules/content/', 'encoded')[0]?.textContent;
                let content = contentEncoded || 
                                item.getElementsByTagName('content:encoded')[0]?.textContent || 
                                item.querySelector('content')?.textContent || '';

                if (prodOrigin && prodOrigin !== currentOrigin) {
                    link = link.replaceAll(prodOrigin, currentOrigin);
                    if (rawGuid.includes(prodOrigin)) {
                        rawGuid = rawGuid.replaceAll(prodOrigin, currentOrigin);
                    }
                    description = description.replaceAll(prodOrigin, currentOrigin);
                    content = content.replaceAll(prodOrigin, currentOrigin);
                }

                const guid = normalizeGuid(rawGuid || link, link);

                return {
                    title,
                    link,
                    guid,
                    pubDate,
                    description,
                    content
                };
            });
        } catch (e) {
            return [];
        }
    }

    function computeDiff(oldText: string, newText: string): Diff.Change[] | null {
        if (!oldText || !newText) return null;

        const normalizeRaw = (text: string): string => {
            const s = String(text || "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
            const lines = s.split("\n").map((line) => line.replace(/[ \t]+$/g, ""));
            return lines.join("\n").trim();
        };

        const normalizeForDiffHtml = (html: string): string => {
            const raw = normalizeRaw(html);
            if (!raw) return "";
            const parser = new DOMParser();
            const doc = parser.parseFromString(`<div>${raw}</div>`, "text/html");
            const root = doc.body.firstElementChild;
            if (!root) return raw;
            const clone = root.cloneNode(true) as Element;
            clone.querySelectorAll("script, style, iframe, object, embed").forEach((el) => el.remove());
            const text = clone.textContent || "";
            return text.replace(/\s+/g, " ").trim();
        };

        const normalizedOld = normalizeForDiffHtml(oldText);
        const normalizedNew = normalizeForDiffHtml(newText);

        if (!normalizedOld || !normalizedNew || normalizedOld === normalizedNew) {
            return null;
        }

        const diffResult = Diff.diffWordsWithSpace(normalizedOld, normalizedNew);
        const hasChanges = diffResult.some((part: Diff.Change) => part.added || part.removed);
        return hasChanges ? diffResult : null;
    }

    function renderDiffToHtml(diffArray: Diff.Change[]): string {
        if (!Array.isArray(diffArray) || diffArray.length === 0) {
            return '<span class="text-zinc-500 italic">无内容变更</span>';
        }
        return diffArray.map((part: Diff.Change) => {
            const text = part.value
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\n/g, '<br>');
            if (part.added) {
                return `<ins class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 no-underline px-1 rounded">${text}</ins>`;
            }
            if (part.removed) {
                return `<del class="bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 no-underline px-1 rounded line-through opacity-70">${text}</del>`;
            }
            return `<span>${text}</span>`;
        }).join('');
    }

    function showNotification(items: Post[], timestamp: number, hasNew: boolean, initTime: number): void {
        const panel = document.getElementById('notification-panel');
        const dot = document.getElementById('notification-dot');
        const list = document.getElementById('new-post-list');
        const minimizeBtn = document.getElementById('minimize-notification');
        const clearBtn = document.getElementById('clear-notification');

        if (!panel || !list) return;

        const isFirstVisit = Date.now() - initTime < 5000;
        const shouldAutoOpen = hasNew && !isFirstVisit;

        if (items.length === 0) {
            list.innerHTML = '<div class="text-zinc-500 dark:text-zinc-400 text-center py-8">暂无新文章</div>';
        } else {
            list.innerHTML = items.map(item => {
                const diffHtml = item.diff ? renderDiffToHtml(item.diff) : '';
                const updatedBadge = item.isUpdated
                    ? '<span class="text-xs bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 px-1.5 py-0.5 rounded-full ml-1">更新</span>'
                    : '<span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-1.5 py-0.5 rounded-full ml-1">新文章</span>';

                return `
                <div class="post-item group p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700/50 transition-colors cursor-pointer border-l-2 ${item.isUpdated ? 'border-amber-400' : 'border-green-400'} bg-zinc-50/50 dark:bg-zinc-800/50" data-link="${item.link}">
                    <div class="font-medium text-zinc-900 dark:text-white text-sm group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors flex items-center flex-wrap gap-1">
                        ${item.title}
                        ${updatedBadge}
                    </div>
                    ${diffHtml ? `<div class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed max-h-24 overflow-y-auto">${diffHtml}</div>` : ''}
                </div>
                `;
            }).join('');

            list.querySelectorAll('.post-item').forEach(el => {
                el.addEventListener('click', () => {
                    const link = el.getAttribute('data-link');
                    if (link) window.location.href = link;
                });
            });
        }

        if (shouldAutoOpen) {
            panel.classList.add('is-open');
            setTimeout(() => panel.classList.add('is-open-content'), 360);
            dot?.classList.add('opacity-0', 'scale-0');
        } else if (hasNew) {
            dot?.classList.remove('opacity-0', 'scale-0', 'translate-y-20');
        }

        panel.classList.remove('translate-y-20', 'opacity-0');

        const minimizedBtn = document.getElementById('notification-minimized');
        if (minimizedBtn) {
            minimizedBtn.onclick = () => {
                const isOpen = panel.classList.contains('is-open');
                if (isOpen) {
                    panel.classList.remove('is-open-content');
                    setTimeout(() => panel.classList.remove('is-open'), 200);
                } else {
                    panel.classList.add('is-open');
                    setTimeout(() => panel.classList.add('is-open-content'), 360);
                    dot?.classList.add('opacity-0', 'scale-0');
                }
            };
        }

        if (minimizeBtn) {
            minimizeBtn.onclick = () => {
                panel.classList.remove('is-open-content');
                setTimeout(() => panel.classList.remove('is-open'), 200);
            };
        }

        if (clearBtn) {
            clearBtn.onclick = async () => {
                try {
                    const db = await openDB();
                    const currentPosts = await getStoredPosts(db, STORE_NEW);
                    await clearStore(db, STORE_OLD);
                    await savePosts(db, STORE_OLD, currentPosts);
                    await clearStore(db, STORE_NEW);
                    localStorage.removeItem(NOTIFICATION_STATE_KEY);
                    showNotification([], Date.now(), false, initTime);
                } catch {}
            };
        }

        if (!panel.getAttribute('data-resize-listening')) {
            const resizeHandler = () => {
                const isMobile = window.innerWidth < 640;
                panel.style.setProperty('--np-open-width', isMobile ? 'calc(100vw - 2rem)' : 'min(20rem, calc(100vw - 2rem))');
                panel.style.setProperty('--np-open-height', isMobile ? 'min(50vh, 16rem)' : 'min(45vh, 20rem)');
            };
            resizeHandler();
            window.addEventListener('resize', resizeHandler);
            panel.setAttribute('data-resize-listening', 'true');
        }
     }

    try {
        const urlParams = new URLSearchParams(window.location.search);
        const isDevMode = urlParams.has('debug-notification');

        if (isDevMode) {
            const mockDiff = [
                { value: "This is some unchanged text context.\n", added: false, removed: false, count: 1 },
                { value: "This line was removed.\n", added: false, removed: true, count: 1 },
                { value: "This line is new.\n", added: true, removed: false, count: 1 },
                { value: "More unchanged text.\n", added: false, removed: false, count: 1 }
            ] as Diff.Change[];
            
            const mockPosts: Post[] = [
                { title: 'Test New Post 1', link: '#', guid: 'test-1', isUpdated: false, pubDate: Date.now(), description: '', content: '' },
                { 
                    title: 'Test Updated Post', 
                    link: '#', 
                    guid: 'test-2', 
                    isUpdated: true,
                    diff: mockDiff,
                    pubDate: Date.now(), 
                    description: '', 
                    content: ''
                },
            ];
            showNotification(mockPosts, Date.now(), true, Date.now());
            return; 
        }

        const currentPosts = await fetchRSS();
        if (currentPosts.length === 0) {
            showNotification([], Date.now(), false, Date.now());
            return;
        }

        const db = await openDB();
        const storedPostsOld = await getStoredPosts(db, STORE_OLD);
        const storedPostsNew = await getStoredPosts(db, STORE_NEW);
        let storedPosts = storedPostsOld;
        if (storedPostsNew.length > 0) {
            storedPosts = storedPostsNew;
            await clearStore(db, STORE_OLD);
            await savePosts(db, STORE_OLD, storedPostsNew);
        }

        let initTimestamp = localStorage.getItem(INIT_TIME_KEY);
        if (!initTimestamp) {
            initTimestamp = Date.now().toString();
            localStorage.setItem(INIT_TIME_KEY, initTimestamp);
        }
        const initTime = parseInt(initTimestamp);

        const localCache = localStorage.getItem(LOCAL_STORAGE_KEY);
        if (storedPostsOld.length === 0 && localCache) {
            await clearStore(db, STORE_OLD);
            await savePosts(db, STORE_OLD, currentPosts);
            await clearStore(db, STORE_NEW);
            localStorage.removeItem(LOCAL_STORAGE_KEY);
            showNotification([], Date.now(), false, initTime);
            return;
        }

        if (storedPostsOld.length === 0) {
            await clearStore(db, STORE_OLD);
            await savePosts(db, STORE_OLD, currentPosts);
            await clearStore(db, STORE_NEW);
            localStorage.removeItem(NOTIFICATION_STATE_KEY);
            // 首次访问也显示通知图标，让用户知道有这个功能
            showNotification([], Date.now(), true, initTime);
        } else {
            await clearStore(db, STORE_NEW);
            await savePosts(db, STORE_NEW, currentPosts);
            
            const storedMap = new Map(
                storedPosts.map(p => [generateId(p.guid), p])
            );
            
            const detectedChanges: Post[] = [];

            currentPosts.forEach(post => {
                const stored = storedMap.get(generateId(post.guid));
                if (!stored) {
                    detectedChanges.push({ ...post, isUpdated: false });
                } else {
                    const titleChanged = post.title !== stored.title;
                    const descriptionChanged = post.description !== stored.description;
                    const contentChanged = post.content !== stored.content;
                    
                    if (titleChanged || descriptionChanged || contentChanged) {
                        let result = null;
                        let hasChanges = false;
                        
                        if (contentChanged && post.content && stored.content) {
                            const contentDiff = computeDiff(stored.content, post.content);
                            if (contentDiff) {
                                result = contentDiff;
                                hasChanges = true;
                            }
                        }
                        
                        if (!hasChanges && descriptionChanged && post.description && stored.description) {
                            const descDiff = computeDiff(stored.description, post.description);
                            if (descDiff) {
                                result = descDiff;
                                hasChanges = true;
                            }
                        }
                        
                        if (!hasChanges && titleChanged) {
                            result = [
                                { value: post.title, added: true, removed: false, count: 1 },
                                { value: stored.title, added: false, removed: true, count: 1 }
                            ];
                            hasChanges = true;
                        }
                        
                        if (hasChanges) {
                            if (__diffLogEnabled) {
                                console.groupCollapsed('[NewPostNotification] computed diff', post.title);
                                console.log({
                                    link: post.link,
                                    guid: post.guid,
                                    titleChanged,
                                    descriptionChanged,
                                    contentChanged
                                });
                                console.log('diff.raw', result);
                                console.groupEnd();
                            }
                            detectedChanges.push({ 
                                ...post, 
                                isUpdated: true, 
                                diff: result,
                                diffType: 'composite'
                            });
                        }
                    }
                }
            });

            if (detectedChanges.length > 0) {
                const isAllNew = detectedChanges.length === currentPosts.length && detectedChanges.every(p => !p.isUpdated);
                const isAllUpdated = detectedChanges.length === currentPosts.length && detectedChanges.every(p => p.isUpdated);

                if (isAllNew || isAllUpdated) {
                    await clearStore(db, STORE_OLD);
                    await savePosts(db, STORE_OLD, currentPosts);
                    await clearStore(db, STORE_NEW);
                    localStorage.removeItem(NOTIFICATION_STATE_KEY);
                    showNotification([], Date.now(), false, initTime);
                    return;
                }

                const timestamp = Date.now();
                const state = {
                    timestamp: timestamp,
                    items: detectedChanges
                };
                localStorage.setItem(NOTIFICATION_STATE_KEY, JSON.stringify(state));
                
                showNotification(detectedChanges, timestamp, true, initTime);
            } else {
                const persistedStateStr = localStorage.getItem(NOTIFICATION_STATE_KEY);
                if (persistedStateStr) {
                    try {
                        const state = JSON.parse(persistedStateStr);
                        showNotification(state.items, state.timestamp, false, initTime);
                    } catch (e) {
                        showNotification([], Date.now(), false, initTime);
                    }
                } else {
                    showNotification([], Date.now(), false, initTime);
                }
            }
        }
    } catch (e) {
        // 静默处理错误
    }
})();
</script>
