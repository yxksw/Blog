---
// Pagefind Search Component
// Supports both desktop and mobile layouts
---

<div class="pagefind-search-container">
  <!-- Desktop Search -->
  <div class="hidden md:block">
    <div class="relative">
      <input
        type="text"
        id="pagefind-search-desktop"
        placeholder="搜索文章..."
        class="w-64 lg:w-80 rounded-xl border border-zinc-200/80 bg-white/75 px-4 py-2.5 pl-10 text-sm text-zinc-700 shadow-[0_8px_30px_rgba(15,23,42,0.06)] backdrop-blur-md transition-all duration-200 placeholder:text-zinc-400 focus:border-zinc-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-zinc-200 dark:border-zinc-700/80 dark:bg-zinc-900/70 dark:text-zinc-300 dark:placeholder:text-zinc-500 dark:focus:border-zinc-600 dark:focus:bg-zinc-900 dark:focus:ring-zinc-700"
      />
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400 dark:text-zinc-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <kbd class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-zinc-200 bg-zinc-50 px-1.5 py-0.5 text-xs font-medium text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 lg:block">
        Ctrl K
      </kbd>
    </div>
    <!-- Desktop Search Results -->
    <div id="search-results-desktop" class="absolute right-0 top-full z-50 mt-2 hidden w-96 rounded-xl border border-zinc-200/80 bg-white/95 p-4 shadow-[0_8px_30px_rgba(15,23,42,0.12)] backdrop-blur-md dark:border-zinc-700/80 dark:bg-zinc-900/95">
      <div id="search-results-content-desktop" class="max-h-96 overflow-y-auto"></div>
    </div>
  </div>

  <!-- Mobile Search Toggle -->
  <div class="md:hidden">
    <button
      id="mobile-search-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200/80 bg-white/75 text-zinc-600 shadow-[0_8px_30px_rgba(15,23,42,0.06)] backdrop-blur-md transition-all duration-200 hover:bg-white hover:text-zinc-900 active:scale-95 dark:border-zinc-700/80 dark:bg-zinc-900/70 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
      aria-label="打开搜索"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </button>
  </div>
</div>

<!-- Mobile Search Modal -->
<div id="mobile-search-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div id="mobile-search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity duration-200"></div>
  
  <!-- Modal Content -->
  <div class="absolute inset-x-0 top-0 p-4">
    <div class="mx-auto max-w-lg rounded-2xl border border-zinc-200/80 bg-white/95 shadow-[0_8px_30px_rgba(15,23,42,0.12)] backdrop-blur-md dark:border-zinc-700/80 dark:bg-zinc-900/95">
      <!-- Search Input -->
      <div class="relative border-b border-zinc-200 dark:border-zinc-700">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-zinc-400 dark:text-zinc-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="pagefind-search-mobile"
          placeholder="搜索文章..."
          class="w-full rounded-t-2xl bg-transparent py-4 pl-12 pr-12 text-base text-zinc-700 placeholder:text-zinc-400 focus:outline-none dark:text-zinc-300"
          autocomplete="off"
        />
        <button
          id="mobile-search-close"
          type="button"
          class="absolute right-4 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-zinc-400 transition-colors hover:bg-zinc-100 hover:text-zinc-600 dark:text-zinc-500 dark:hover:bg-zinc-800 dark:hover:text-zinc-300"
          aria-label="关闭搜索"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <!-- Search Results -->
      <div id="search-results-mobile" class="max-h-[60vh] overflow-y-auto p-2">
        <div id="search-results-content-mobile"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // Pagefind Search Implementation
  (function() {
    let pagefind = null;
    const BASE = window.__BASE_URL || '/';

    // Initialize Pagefind
    async function initPagefind() {
      if (pagefind) return pagefind;
      
      try {
        // Dynamically import pagefind
        const module = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        pagefind = module;
        await pagefind.init();
        return pagefind;
      } catch (error) {
        console.error('Failed to load Pagefind:', error);
        return null;
      }
    }

    // Search function
    async function performSearch(query, containerId, isMobile) {
      if (!query.trim()) {
        const container = document.getElementById(containerId);
        if (container) container.classList.add('hidden');
        return;
      }

      const pf = await initPagefind();
      if (!pf) {
        showError(containerId, '搜索功能加载失败，请稍后重试');
        return;
      }

      try {
        const search = await pf.search(query);
        displayResults(search, containerId, isMobile);
      } catch (error) {
        console.error('Search error:', error);
        showError(containerId, '搜索出错，请重试');
      }
    }

    // Display search results
    function displayResults(search, containerId, isMobile) {
      const container = document.getElementById(containerId);
      const contentId = containerId.replace('search-results', 'search-results-content');
      const content = document.getElementById(contentId);
      
      if (!container || !content) return;

      container.classList.remove('hidden');

      if (!search.results || search.results.length === 0) {
        content.innerHTML = `
          <div class="py-8 text-center text-zinc-500 dark:text-zinc-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-3 h-12 w-12 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p>没有找到相关文章</p>
          </div>
        `;
        return;
      }

      // Fetch and display results
      Promise.all(search.results.slice(0, 8).map(async (result) => {
        const data = await result.data();
        return data;
      })).then((results) => {
        content.innerHTML = results.map((data) => `
          <a 
            href="${data.url}" 
            class="group block rounded-lg p-3 transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800 ${isMobile ? '' : ''}"
          >
            <h3 class="font-medium text-zinc-900 group-hover:text-zinc-700 dark:text-zinc-100 dark:group-hover:text-zinc-300">
              ${data.meta?.title || '无标题'}
            </h3>
            <p class="mt-1 line-clamp-2 text-sm text-zinc-500 dark:text-zinc-400">
              ${data.excerpt || data.meta?.description || ''}
            </p>
            ${data.meta?.tags ? `
              <div class="mt-2 flex flex-wrap gap-1">
                ${data.meta.tags.split(',').map((tag) => `
                  <span class="inline-flex items-center rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                    ${tag.trim()}
                  </span>
                `).join('')}
              </div>
            ` : ''}
          </a>
        `).join('');
      });
    }

    // Show error message
    function showError(containerId, message) {
      const container = document.getElementById(containerId);
      const contentId = containerId.replace('search-results', 'search-results-content');
      const content = document.getElementById(contentId);
      
      if (container && content) {
        container.classList.remove('hidden');
        content.innerHTML = `
          <div class="py-6 text-center text-zinc-500 dark:text-zinc-400">
            <p>${message}</p>
          </div>
        `;
      }
    }

    // Debounce function
    function debounce(func, wait) {
      let timeout;
      return (...args) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => func(...args), wait);
      };
    }

    // Desktop search
    const desktopInput = document.getElementById('pagefind-search-desktop') as HTMLInputElement;
    const desktopResults = document.getElementById('search-results-desktop');

    if (desktopInput) {
      const debouncedSearch = debounce((query: string) => {
        performSearch(query, 'search-results-desktop', false);
      }, 200);

      desktopInput.addEventListener('input', (e) => {
        debouncedSearch((e.target as HTMLInputElement).value);
      });

      // Close results when clicking outside
      document.addEventListener('click', (e) => {
        if (desktopResults && !desktopInput.contains(e.target as Node) && !desktopResults.contains(e.target as Node)) {
          desktopResults.classList.add('hidden');
        }
      });

      // Keyboard shortcut
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          desktopInput.focus();
        }
        if (e.key === 'Escape') {
          desktopResults?.classList.add('hidden');
        }
      });
    }

    // Mobile search
    const mobileToggle = document.getElementById('mobile-search-toggle');
    const mobileModal = document.getElementById('mobile-search-modal');
    const mobileBackdrop = document.getElementById('mobile-search-backdrop');
    const mobileClose = document.getElementById('mobile-search-close');
    const mobileInput = document.getElementById('pagefind-search-mobile') as HTMLInputElement;

    function openMobileSearch() {
      mobileModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => mobileInput?.focus(), 100);
    }

    function closeMobileSearch() {
      mobileModal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (mobileInput) mobileInput.value = '';
      document.getElementById('search-results-mobile')?.classList.add('hidden');
    }

    if (mobileToggle) {
      mobileToggle.addEventListener('click', openMobileSearch);
    }

    if (mobileClose) {
      mobileClose.addEventListener('click', closeMobileSearch);
    }

    if (mobileBackdrop) {
      mobileBackdrop.addEventListener('click', closeMobileSearch);
    }

    if (mobileInput) {
      const debouncedSearch = debounce((query: string) => {
        performSearch(query, 'search-results-mobile', true);
      }, 200);

      mobileInput.addEventListener('input', (e) => {
        debouncedSearch((e.target as HTMLInputElement).value);
      });

      mobileInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeMobileSearch();
        }
      });
    }

    // Close mobile search on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileModal && !mobileModal.classList.contains('hidden')) {
        closeMobileSearch();
      }
    });
  })();
</script>

<style>
  /* Custom scrollbar for search results */
  #search-results-content-desktop::-webkit-scrollbar,
  #search-results-content-mobile::-webkit-scrollbar {
    width: 6px;
  }

  #search-results-content-desktop::-webkit-scrollbar-track,
  #search-results-content-mobile::-webkit-scrollbar-track {
    background: transparent;
  }

  #search-results-content-desktop::-webkit-scrollbar-thumb,
  #search-results-content-mobile::-webkit-scrollbar-thumb {
    background-color: rgb(161 161 170);
    border-radius: 20px;
  }

  .dark #search-results-content-desktop::-webkit-scrollbar-thumb,
  .dark #search-results-content-mobile::-webkit-scrollbar-thumb {
    background-color: rgb(82 82 91);
  }

  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Animation for mobile modal */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #mobile-search-modal:not(.hidden) > div:last-child {
    animation: slideDown 200ms ease-out;
  }
</style>
