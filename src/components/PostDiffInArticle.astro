---
// 文章内差异展示组件
---

<div id="post-diff-section" class="hidden mb-6 rounded-xl border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20 overflow-hidden">
    <div class="px-4 py-3 border-b border-blue-200 dark:border-blue-800 bg-blue-100 dark:bg-blue-900/30 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue-600 dark:text-blue-400">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
            <span class="text-sm font-medium text-blue-800 dark:text-blue-200">文章更新内容</span>
        </div>
        <button id="toggle-diff" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
            展开
        </button>
    </div>
    <div id="diff-content" class="hidden p-4 text-sm text-zinc-700 dark:text-zinc-300 space-y-3">
        <!-- 差异内容将在这里显示 -->
    </div>
</div>

<script is:inline>
    (function() {
        async function init() {
            // 只在文章页面运行
            const postContainer = document.querySelector('.markdown-prose, .markdown-content');
            const diffSection = document.getElementById('post-diff-section');
            const diffContent = document.getElementById('diff-content');
            const toggleBtn = document.getElementById('toggle-diff');
            
            if (!postContainer || !diffSection || !window.RSSUtils) return;

            const currentPath = window.location.pathname;
            
            // 从 RSS 获取当前文章的历史内容
            const post = await window.RSSUtils.getPostContentFromRSS(currentPath);
            if (!post) return;

            // 检查是否有更新（通过比较当前页面内容和 RSS 中的内容）
            const currentContent = postContainer.innerHTML;
            const rssContent = post.content || post.description;
            
            if (!rssContent || currentContent === rssContent) return;

            // 显示差异区域
            diffSection.classList.remove('hidden');
            
            // 简单的差异展示
            diffContent.innerHTML = `
                <div class="text-xs text-zinc-500 dark:text-zinc-400 mb-2">
                    检测到文章有更新，以下是变更摘要：
                </div>
                <div class="bg-white dark:bg-zinc-800 rounded p-3 text-xs font-mono overflow-x-auto">
                    <div class="text-green-600 dark:text-green-400">+ 文章已更新</div>
                    <div class="text-zinc-500 dark:text-zinc-400 mt-1">
                        最后更新: ${new Date().toLocaleDateString('zh-CN')}
                    </div>
                </div>
            `;

            // 展开/收起
            let isExpanded = false;
            toggleBtn?.addEventListener('click', () => {
                isExpanded = !isExpanded;
                diffContent.classList.toggle('hidden', !isExpanded);
                toggleBtn.textContent = isExpanded ? '收起' : '展开';
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        document.addEventListener('astro:page-load', init);
    })();
</script>
