[
  { "text": "每一段旅行，都有终点。", "author": "龙泽尔·爱德华", "lang": "zh", "tag": "诡秘之主" },
  { "text": "总有些事情，高于其他。", "author": "克莱恩·莫雷蒂", "lang": "zh", "tag": "诡秘之主" },
  { "text": "愿你看清一切真相后，依旧热爱你的家人和朋友。", "author": "格尔曼·斯帕罗", "lang": "zh", "tag": "诡秘之主" },
  { "text": "光就是一切的意义！", "author": "戴里克·伯格", "lang": "zh", "tag": "诡秘之主" },
  { "text": "每一个溺水的人，都会挣扎。", "author": "特莉丝·梅森", "lang": "zh", "tag": "诡秘之主" },
  { "text": "通往光的门已经出现。", "author": "戴里克·伯格", "lang": "zh", "tag": "诡秘之主" },

  { "text": "欢迎来到，神许诺的--光明世界！", "author": "烈焰·达尼兹", "lang": "zh", "tag": "诡秘之主" },
  { "text": "我们是守护者，也是一群时刻对抗着危险和疯狂的可怜虫。", "author": "邓恩·史密斯", "lang": "zh", "tag": "诡秘之主" }
]
